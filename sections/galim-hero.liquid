{%- comment -%}
  Galim Health — Hero
  Full-bleed image + layered dark gradients. One centred column of copy over the
  figure at every width:
    launch line -> headline -> description -> pricing pill -> package cards ->
    footnote -> CTA.
  Primary CTA opens the waitlist modal.
  Plan chips carry the pricing pill, the package cards and the footnote.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign has_image = false
  if s.image != blank or s.image_url != blank
    assign has_image = true
  endif
-%}

<section id="{{ s.anchor_id | default: 'top' }}" class="gh-hero" data-gh-section="hero" style="--gh-hero-h1-max: {{ s.heading_size | default: 52 }}px; --gh-hero-h1-min: {{ s.heading_size_mobile | default: 30 }}px; --gh-hero-tint: {{ s.overlay_strength | default: 45 | divided_by: 100.0 }}; --gh-side-color: {{ s.side_color | default: '#0D3B46' }}; --gh-side-width: {{ s.side_width | default: 22 }}%;">
  {%- liquid
    assign desktop_img = s.image
    assign mobile_img = s.image_mobile
    if mobile_img == blank
      assign mobile_img = desktop_img
    endif
    assign fallback_src = ''
    if desktop_img != blank
      assign fallback_src = desktop_img | image_url: width: 2400
    elsif s.image_url != blank
      assign fallback_src = s.image_url
    elsif s.image_url_mobile != blank
      assign fallback_src = s.image_url_mobile
    else
      assign fallback_src = 'hero-large.jpg' | asset_url
    endif
  -%}
  <div class="gh-hero__media">
    {%- comment -%} Blurred copy of the image fills the sides edge-to-edge so the
      contained (full) figure never shows a seam against the background. {%- endcomment -%}
    {%- if fallback_src != blank -%}
      <div class="gh-hero__backdrop" aria-hidden="true" style="background-image: url({{ fallback_src }});"></div>
    {%- endif -%}
    {%- if desktop_img != blank or mobile_img != blank or fallback_src != blank -%}
      <picture>
        {%- comment -%} Mobile: portrait-ish, retina-ready (up to ~3x of 800px) {%- endcomment -%}
        {%- if mobile_img != blank -%}
          <source
            media="(max-width: 767px)"
            srcset="{{ mobile_img | image_url: width: 800 }} 800w, {{ mobile_img | image_url: width: 1200 }} 1200w, {{ mobile_img | image_url: width: 1600 }} 1600w"
            sizes="100vw">
        {%- elsif s.image_url_mobile != blank -%}
          <source media="(max-width: 767px)" srcset="{{ s.image_url_mobile }}">
        {%- endif -%}
        {%- comment -%} Desktop: full-bleed, retina-ready up to 3200w {%- endcomment -%}
        {%- if desktop_img != blank -%}
          <source
            media="(min-width: 768px)"
            srcset="{{ desktop_img | image_url: width: 1600 }} 1600w, {{ desktop_img | image_url: width: 2000 }} 2000w, {{ desktop_img | image_url: width: 2600 }} 2600w, {{ desktop_img | image_url: width: 3200 }} 3200w"
            sizes="100vw">
        {%- elsif s.image_url != blank -%}
          <source media="(min-width: 768px)" srcset="{{ s.image_url }}">
        {%- endif -%}
        <img class="gh-hero__img" src="{{ fallback_src }}" alt="{{ s.image.alt | escape | default: shop.name }}" loading="eager" fetchpriority="high" decoding="async" onerror="this.style.display='none'">
      </picture>
    {%- endif -%}
    <div class="gh-hero__tint"></div>
    <div class="gh-hero__grad-h"></div>
    <div class="gh-hero__grad-v"></div>
    <div class="gh-hero__grid"></div>
    <div class="gh-hero__sides" aria-hidden="true"></div>
  </div>

  {%- comment -%}
    Plan blocks play three different roles, told apart by which fields are filled
    rather than by position, so reordering them in the customizer can't break the
    layout:
      - time and/or price  -> a package card
      - name only, first   -> the pill above the cards ("FOUNDING MEMBER PRICING")
      - name only, after   -> a footnote above the button ("FIRST 500 …")
    Fully empty blocks are skipped instead of rendering an empty card.
  {%- endcomment -%}
  {%- liquid
    assign pill_index = -1
    for block in section.blocks
      if block.type != 'plan'
        continue
      endif
      if block.settings.time == blank and block.settings.price == blank and block.settings.name != blank
        assign pill_index = forloop.index0
        break
      endif
    endfor
  -%}

  <div class="gh-hero__inner">
    <div class="gh-hero__col">
      {%- if s.coming_soon != blank -%}
        <p class="gh-hero__stamp">
          <span class="gh-hero__dot"></span>
          <span class="gh-hero__stamp-label">{{ s.coming_soon }}</span>
          {%- if s.coming_soon_sub != blank -%}
            <span class="gh-hero__stamp-date">{{ s.coming_soon_sub }}</span>
          {%- endif -%}
        </p>
      {%- endif -%}

      {%- if s.badge != blank -%}
        <div class="gh-hero__badge">
          <span class="gh-hero__dot"></span>{{ s.badge }}
        </div>
      {%- endif -%}

      {%- if s.heading != blank or s.heading_accent != blank -%}
        <h1 class="gh-hero__h1">
          {{- s.heading | newline_to_br -}}
          {%- if s.heading_accent != blank -%}
            {%- if s.heading != blank -%}<br>{%- endif -%}
            <span class="gh-hero__h1-accent">{{ s.heading_accent }}</span>
          {%- endif -%}
        </h1>
      {%- endif -%}

      {%- if s.subheading != blank -%}
        <p class="gh-hero__sub">{{ s.subheading }}</p>
      {%- endif -%}

      {%- if s.council_line != blank -%}
        <p class="gh-hero__council">{{ s.council_line }}</p>
      {%- endif -%}

      {%- comment -%}
        The offer: a pricing pill labelling the package cards below it. Set apart
        from the pitch above by space alone — a rule here read as a division
        through the middle of the hero.
      {%- endcomment -%}
      {%- if section.blocks.size > 0 -%}
        <div class="gh-hero__offer">
          {%- for block in section.blocks -%}
            {%- if block.type == 'plan' and forloop.index0 == pill_index -%}
              <p class="gh-hero__stamp gh-hero__stamp--offer" {{ block.shopify_attributes }}>{{ block.settings.name }}</p>
            {%- endif -%}
          {%- endfor -%}

          <div class="gh-hero__plans">
            {%- for block in section.blocks -%}
              {%- if block.type != 'plan' -%}{%- continue -%}{%- endif -%}
              {%- if block.settings.time == blank and block.settings.price == blank -%}{%- continue -%}{%- endif -%}
              {%- liquid
                assign plan_href = block.settings.link
                if plan_href == blank
                  assign plan_href = '#plans'
                endif
              -%}
              <a href="{{ plan_href }}" class="gh-hero__plan" {{ block.shopify_attributes }}>
                <span class="gh-hero__plan-meta">
                  {%- if block.settings.time != blank -%}<span class="gh-hero__plan-time">{{ block.settings.time }}</span>{%- endif -%}
                  {%- if block.settings.name != blank -%}<span class="gh-hero__plan-name">{{ block.settings.name }}</span>{%- endif -%}
                </span>
                {%- if block.settings.price != blank -%}
                  <span class="gh-hero__plan-price">
                    {{- block.settings.price -}}
                    {%- if block.settings.price_unit != blank -%}
                      <span class="gh-hero__plan-unit">{{ block.settings.price_unit }}</span>
                    {%- endif -%}
                  </span>
                {%- endif -%}
              </a>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      <div class="gh-hero__actions">
        {%- comment -%}
          Footnote sits ABOVE the CTA: it qualifies the offer, so it belongs with
          the pricing rather than trailing the button.
        {%- endcomment -%}
        {%- for block in section.blocks -%}
          {%- if block.type != 'plan' -%}{%- continue -%}{%- endif -%}
          {%- if block.settings.name == blank -%}{%- continue -%}{%- endif -%}
          {%- if block.settings.time != blank or block.settings.price != blank -%}{%- continue -%}{%- endif -%}
          {%- if forloop.index0 == pill_index -%}{%- continue -%}{%- endif -%}
          <p class="gh-hero__note" {{ block.shopify_attributes }}>{{ block.settings.name }}</p>
        {%- endfor -%}

        {%- if s.button_label != blank -%}
          {%- if s.button_opens_modal -%}
            <a href="#" class="gh-btn gh-btn--solid" data-gh-waitlist-open>{{ s.button_label }} →</a>
          {%- else -%}
            <a href="{{ s.button_link | default: '#' }}" class="gh-btn gh-btn--solid">{{ s.button_label }} →</a>
          {%- endif -%}
        {%- endif -%}

        {%- if s.coords != blank -%}
          <span class="gh-hero__coords">{{ s.coords }}</span>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  /* Galim Health — Hero
     Copy is centred and bottom-anchored at every width, over a vertical scrim
     plus a local halo. The figure stays centred behind it. The package cards and
     the CTA share one width so they read as a single block. */

  .gh-hero {
    position: relative;
    /* Dark island on the light site: keep text/accents light over the photo */
    --gh-light: #F7F5F3;
    --gh-white: #F7F5F3;
    --gh-muted: #A8C2C8;
    --gh-slate: #A8C2C8;
    --gh-green: #A8C2C8;
    --gh-accent: #A8C2C8;
    /* Cyan accent, scoped to the hero: the glow colour for the status dot, the
       launch date, the card labels and the pill hairlines. Kept off the global
       token set so it can't leak into the light sections below. */
    --gh-cyan: #7DE3E8;
    /* Cinematic hero sized to the 4503×1851 artwork (~2.43:1), but expressed as
       a MINIMUM height rather than aspect-ratio. aspect-ratio fixes the height
       from the width, so the taller copy column would be clipped by the
       overflow:hidden below at the widths where the ratio's height falls under
       the copy's (measured: 15px of headroom left at 1380px). As a minimum, the
       hero keeps the exact ratio whenever the copy fits and grows instead of
       cropping when it doesn't. 41.11vw = 1851/4503. */
    min-height: max(560px, 41.11vw);
    overflow: hidden;
    /* Copy centred over the figure, in normal flow — flow is what lets the hero
       grow instead of cropping. Bottom padding is generous so the button lands
       clear of the bottom edge rather than pinned to it. */
    display: flex; justify-content: flex-start; align-items: flex-end;
    /* Left padding is a percentage, not 40px: the headline lives inside the
       banner image, and the image spans the full width, so its text starts at a
       fixed FRACTION of the viewport (~6.4%). A fixed pixel padding would drift
       away from it as the window widens. */
    padding: 56px 40px 72px 6.4%;
    /* The theme ships no global border-box reset, so without this min-height
       would size the CONTENT box and the padding would push the hero 112px past
       the ratio. */
    box-sizing: border-box;
    /* Matches the figure image's own teal/green gradient so the (contained)
       photo blends edge-to-edge with no visible letterbox. */
    background:
      radial-gradient(70% 60% at 88% 8%, rgba(92, 178, 74, 0.30), rgba(92, 178, 74, 0) 55%),
      radial-gradient(70% 70% at 8% 96%, rgba(40, 165, 128, 0.26), rgba(40, 165, 128, 0) 55%),
      linear-gradient(135deg, #082B34 0%, #0D3B46 45%, #06222A 100%);
  }
  .gh-hero__media { position: absolute; inset: 0; overflow: hidden; }
  /* Blurred, scaled copy of the same photo — fills the whole hero so the
     contained figure has no visible letterbox/seam on wide screens. */
  .gh-hero__backdrop {
    position: absolute; inset: 0; z-index: 0;
    background-size: cover; background-position: center;
    filter: blur(42px) brightness(0.72) saturate(1.15);
    transform: scale(1.18);
  }
  .gh-hero__img {
    position: absolute; inset: 0; z-index: 1;
    width: 100%; height: 100%;
    /* Show the FULL figure (no crop); the blurred backdrop fills the sides */
    object-fit: contain; object-position: center;
  }
  /* Optional teal tint over the full photo (customizer slider) */
  .gh-hero__tint { position: absolute; inset: 0; background: rgb(13 59 70 / var(--gh-hero-tint, 0.2)); pointer-events: none; }
  /* Side vignette only. The old version anchored a heavy scrim to the right
     because the copy lived there; now that the copy is centred, the darkening
     that matters is the vertical ramp below plus the halo behind the text. */
  .gh-hero__grad-h {
    position: absolute; inset: 0; pointer-events: none;
    background:
      linear-gradient(270deg, rgba(8, 43, 52, 0.34) 0%, rgba(8, 43, 52, 0) 26%),
      linear-gradient(90deg, rgba(8, 43, 52, 0.34) 0%, rgba(8, 43, 52, 0) 26%);
  }
  /* Vertical ramp: shown at every width now, weighted to the bottom half where
     the copy sits. */
  .gh-hero__grad-v {
    position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(180deg,
      rgba(8, 43, 52, 0.42) 0%,
      rgba(8, 43, 52, 0.10) 22%,
      rgba(8, 43, 52, 0.46) 52%,
      rgba(8, 43, 52, 0.80) 78%,
      rgba(8, 43, 52, 0.92) 100%);
  }
  .gh-hero__grid { display: none; }

  /* Side fades: brand color at the edges, transparent toward the center */
  .gh-hero__sides { position: absolute; inset: 0; pointer-events: none; z-index: 2; }
  .gh-hero__sides::before,
  .gh-hero__sides::after {
    content: "";
    position: absolute; top: 0; bottom: 0;
    width: var(--gh-side-width, 22%);
    pointer-events: none;
  }
  .gh-hero__sides::before {
    left: 0;
    background: linear-gradient(to right, var(--gh-side-color, #0D3B46), rgba(9,46,43,0));
  }
  .gh-hero__sides::after {
    right: 0;
    background: linear-gradient(to left, var(--gh-side-color, #0D3B46), rgba(9,46,43,0));
  }

  /* Content: absolute bottom-right on desktop. One column, not two competing
     focal points — the copy carries the whole message and the left of the frame
     stays pure image. */
  .gh-hero__inner {
    position: relative; z-index: 4;
    width: 620px; max-width: 100%;
    color: #f6f5ee;
    text-align: left;
  }
  /* Halo behind the copy — darkens the figure locally so the text reads, without
     drawing a visible box. Applies at every width now (it used to be mobile
     only, back when the desktop copy sat off to the side over the dark edge). */
  /* Only when the hero actually renders copy. With the headline baked into the
     banner artwork the column holds just the CTA, and the halo showed up as a
     dark blob around the button with no text to justify it. */
  .gh-hero__inner:has(.gh-hero__h1, .gh-hero__stamp, .gh-hero__sub, .gh-hero__badge, .gh-hero__plans)::before {
    content: "";
    position: absolute; left: -80px; right: -80px; top: -48px; bottom: -40px;
    /* Two stops: a dense core under the text and a wide soft skirt. A single
       stop either left the type sitting on bright contour lines or washed the
       figure out — and the figure is what makes the hero feel technological. */
    background:
      radial-gradient(62% 56% at 50% 54%, rgba(6, 31, 38, 0.86), rgba(6, 31, 38, 0) 72%),
      radial-gradient(92% 84% at 50% 52%, rgba(6, 31, 38, 0.52), rgba(6, 31, 38, 0) 78%);
    filter: blur(12px);
    pointer-events: none;
    z-index: -1;
  }
  .gh-hero__col { display: block; }

  /* Launch line — plain type, no capsule. It's the loudest thing after the
     headline, so a border only boxed it in and capped how large it could read. */
  .gh-hero__stamp {
    display: flex; width: fit-content;
    align-items: center; margin: 0 auto; padding: 0;
    font: 500 17px/1.2 var(--gh-mono); letter-spacing: 0.2em; text-transform: uppercase;
    color: #F7F5F3;
    text-shadow: 0 2px 16px rgba(6, 31, 38, 0.7);
  }
  .gh-hero__stamp .gh-hero__dot { margin-right: 12px; }
  .gh-hero__stamp-date { color: var(--gh-cyan); }
  .gh-hero__stamp-date::before { content: "\00b7"; margin: 0 12px; opacity: 0.5; color: #F7F5F3; }

  /* The pricing label keeps the glass capsule — it labels the cards under it, and
     the blur separates it from the figure without an opaque plate. */
  .gh-hero__stamp--offer {
    padding: 10px 20px;
    border-radius: 999px;
    font-size: 11px; letter-spacing: 0.2em;
    color: var(--gh-cyan);
    background: rgba(10, 46, 56, 0.40);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    border: 1px solid rgba(125, 227, 232, 0.22);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.16),
      0 8px 28px rgba(6, 31, 38, 0.45);
    text-shadow: 0 1px 10px rgba(6, 31, 38, 0.5);
  }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .gh-hero__stamp--offer { background: rgba(8, 38, 47, 0.82); }
  }

  .gh-hero__badge {
    display: inline-flex; align-items: center; gap: 9px; margin-top: 18px;
    font: 500 12px/1 var(--gh-mono);
    letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--gh-green);
  }
  .gh-hero__dot {
    width: 6px; height: 6px; border-radius: 50%; display: inline-block;
    background: var(--gh-cyan);
    box-shadow: 0 0 7px rgba(125, 227, 232, 0.9), 0 0 16px rgba(125, 227, 232, 0.45);
  }

  /* The outcome, and the biggest thing on the page — but capped well short of the
     column so it breaks into two comfortable lines instead of stretching edge to
     edge. */
  .gh-hero__h1 {
    /* Bigger gap under the launch pill than the rest of the rhythm: the block is
       bottom-anchored, so this space is what lifts the pill up the frame while
       the headline and everything under it stay put. */
    margin: 62px auto 0; max-width: 9.6em;
    font: 300 clamp(var(--gh-hero-h1-min, 30px), 4vw, var(--gh-hero-h1-max, 56px))/1.06 var(--gh-sans);
    letter-spacing: -0.022em;
    color: #f6f5ee;
    text-wrap: balance;
  }
  .gh-hero__h1-accent { font-weight: 500; }
  /* Supporting proof: the technology explains the promise, it doesn't lead it. */
  .gh-hero__sub {
    margin: 24px auto 0; max-width: 400px;
    font: 300 17px/1.6 var(--gh-sans);
    color: rgba(246, 245, 238, 0.86);
  }

  /* Offer group — everything that answers "why book now". No rule across the
     top: it read as a division through the middle of the hero and cut the
     composition in half. Space does the separating. */
  .gh-hero__offer { margin-top: 46px; }
  .gh-hero__council { display: none; }
  .gh-hero__coords {
    display: inline-block;
    font: 400 12px/1.4 var(--gh-mono);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    /* Dark, not the hero's light token: the banner artwork is light behind the
       CTA, where this sits. */
    color: #0D3B46;
    /* No left rule: that was a divider against the button when they shared a
       row. Stacked and centred, it would read as a stray tick. */
  }

  /* Plans as package cards: label on the left, price on the right. Replaces the
     three-column price table — as a table the short package name stranded a gap
     before its price and the whole block read as an afterthought. A card gives
     each package its own object and lets the price be the loud part. */
  .gh-hero__plans {
    list-style: none; margin: 20px auto 0; padding: 0;
    /* Grid with equal rows, not a flex column: her longest package name wraps to
       two lines beside the price, and without this the two cards came out
       different heights, which reads as a mistake rather than a pair. */
    display: grid; grid-auto-rows: 1fr; gap: 12px;
    max-width: 440px;
    /* Sits close under its own pill — they're one unit. */
  }
  .gh-hero__plan {
    box-sizing: border-box;
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    padding: 13px 18px;
    border-radius: 14px;
    text-align: left;
    color: inherit;
    background: rgba(255, 255, 255, 0.055);
    backdrop-filter: blur(16px) saturate(1.15);
    -webkit-backdrop-filter: blur(16px) saturate(1.15);
    border: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.11),
      0 10px 32px rgba(6, 31, 38, 0.32);
    transition: background 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
  }
  .gh-hero__plan:hover {
    background: rgba(255, 255, 255, 0.10);
    border-color: rgba(125, 227, 232, 0.42);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.18),
      0 14px 40px rgba(6, 31, 38, 0.42),
      0 0 24px rgba(125, 227, 232, 0.16);
    transform: translateY(-2px);
  }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .gh-hero__plan { background: rgba(9, 42, 52, 0.72); }
  }
  /* Duration and package name read as one label on a single line. */
  .gh-hero__plan-meta {
    display: block; min-width: 0;
    font: 500 11.5px/1.35 var(--gh-mono);
    letter-spacing: 0.13em; text-transform: uppercase;
    color: var(--gh-cyan);
  }
  .gh-hero__plan-time { white-space: nowrap; }
  /* Separator only between two present parts, so a card with just a name has no
     stray leading dot. */
  .gh-hero__plan-name:not(:first-child)::before { content: " · "; opacity: 0.6; }
  .gh-hero__plan-price {
    flex: none;
    font: 500 clamp(13.5px, 2.9vw, 15.5px)/1 var(--gh-mono);
    letter-spacing: 0;
    color: #F7F5F3;
    font-variant-numeric: tabular-nums;
  }
  /* Currency rides with the price but steps back so the number stays the figure
     you read first. */
  .gh-hero__plan-unit {
    margin-left: 5px;
    font-size: 0.68em; font-weight: 500;
    letter-spacing: 0.08em;
    color: rgba(246, 245, 238, 0.62);
  }

  /* Footnote under the button — the smallest, quietest thing in the hero. */
  .gh-hero__note {
    /* Never wider than the column: at 340px with tracking it spilled past the
       hero's side padding. Wraps instead. */
    margin: 0; max-width: 100%;
    font: 500 9.5px/1.5 var(--gh-mono);
    letter-spacing: 0.16em; text-transform: uppercase;
    color: rgba(246, 245, 238, 0.55);
  }

  /* Solid cream button */
  /* Stacked, not a row: with the address beside it the button sat left of centre
     even though the row itself was centred. */
  .gh-hero__actions {
    display: flex; flex-direction: column; align-items: flex-start;
    gap: 0; margin-top: 30px;
  }
  /* Footnote hugs the pricing above it; the CTA sits clearly below both. */
  .gh-hero__note + .gh-btn--solid { margin-top: 34px; }
  .gh-btn--solid + .gh-hero__coords { margin-top: 18px; }
  .gh-hero .gh-btn--solid {
    background: #F7F5F3;
    color: #135E73;
    /* Same width as the package cards above it: sharing one edge is what makes
       the cards and the CTA read as a single block rather than loose parts.
       border-box because the theme has no global reset — width:100% plus padding
       pushed the button past the hero's side padding and it ran edge to edge. */
    box-sizing: border-box;
    width: 100%; max-width: 440px; justify-content: center;
    padding: 16px 34px;
    border-radius: 999px;
    font: 500 16px/1 var(--gh-sans);
    letter-spacing: 0.02em;
    text-shadow: none;
  }
  .gh-hero .gh-btn--solid {
    box-shadow: none;
    transition: background 0.25s ease, color 0.25s ease;
  }
  .gh-hero .gh-btn--solid:hover { background: #FFFFFF; color: #135E73; }

  /* MOBILE (5c): full image, content stacked BELOW it — never overlapping.
     Earlier this cropped the image (object-fit: cover) and anchored the copy
     over the bottom of it, hand-calibrated to one specific photo's internal
     layout (head/pricing-panel percentages). That breaks the moment a
     different image — especially one with its own baked-in headline/pricing
     graphic, as opposed to a plain photo — has a different internal layout:
     the overlaid button ends up sitting wherever flex-end lands, regardless
     of what's actually drawn there in the image. Showing the full image
     (object-fit: contain, natural aspect-ratio box) with the copy in normal
     flow after it — not stacked on top via position:absolute — means any
     image works without per-photo recalibration, at the cost of the image
     and the copy no longer being able to visually merge into one scene. */
  @media (max-width: 768px) {
    .gh-hero { display: block; min-height: 0; padding: 0; }
    .gh-hero__media {
      position: relative; inset: auto;
      width: 100%; aspect-ratio: 1080 / 1920;
      background: var(--gh-side-color, #0D3B46);
    }
    .gh-hero__backdrop { display: none; }
    .gh-hero__img { object-fit: contain; object-position: center; }
    /* These scrims existed to keep overlaid text legible against the photo;
       with the copy no longer drawn over the image on mobile, they'd only
       tint the image for no reason. */
    .gh-hero__tint,
    .gh-hero__grad-h,
    .gh-hero__grad-v,
    .gh-hero__sides { display: none; }
    .gh-hero__inner {
      position: relative;
      width: 100%; max-width: none;
      /* No gap: the button sits right at the bottom edge of the full,
         uncropped image, not pulled up over its content and not pushed
         down after a padded gap. */
      margin-top: 0;
      padding: 0 20px 32px;
      box-sizing: border-box;
    }
    /* The halo existed to darken the photo locally behind overlaid text;
       nothing overlays the image on mobile anymore. */
    .gh-hero__inner:has(.gh-hero__h1, .gh-hero__stamp, .gh-hero__sub, .gh-hero__badge, .gh-hero__plans)::before {
      display: none;
    }
    .gh-hero__badge { justify-content: center; margin-bottom: 0; font-size: 10px; }
    /* Scales down on narrow phones instead of running into the edges. Now the
       dominant element — the old size (25-30px) sat below COMING SOON's 34-52px,
       which buried the outcome under the announcement. */
    .gh-hero__h1 { font-size: clamp(27px, 7.8vw, 33px); line-height: 1.1; margin-top: 48px; max-width: 9.2em; text-shadow: 0 2px 20px rgba(6, 31, 38, 0.5); }
    /* Slightly narrower measure = fewer, better-balanced lines */
    .gh-hero__sub { font-size: 14.5px; line-height: 1.55; margin: 18px auto 0; max-width: 300px; text-shadow: 0 1px 14px rgba(6, 31, 38, 0.65); }
    .gh-hero__offer { margin-top: 36px; }
    .gh-hero__stamp { padding: 0; font-size: clamp(12px, 3.7vw, 15px); letter-spacing: 0.14em; }
    .gh-hero__stamp--offer { padding: 9px 16px; font-size: 10px; letter-spacing: 0.18em; }
    /* No max-width override here: the base 440px cap already collapses to the
       column width on phones, and forcing 100% made the cards 728px wide at
       768px while the button stayed at 440px. */
    .gh-hero__plans {
      gap: 10px; margin: 16px auto 0;
      text-shadow: 0 1px 12px rgba(6, 31, 38, 0.7);
    }
    /* Tighter card padding, and the label steps down so the longest one
       ("50 MIN · BODY PERFORMANCE + PREVENTION") stays on one line beside the
       price. It wraps rather than clipping if a name gets longer than that. */
    .gh-hero__plan { padding: 11px 14px; gap: 10px; }
    .gh-hero__plan-meta { font-size: clamp(8.2px, 2.6vw, 11px); letter-spacing: 0.07em; }
    .gh-hero__plan-price { font-size: clamp(12px, 3.2vw, 14px); }
    .gh-hero__plan-unit { margin-left: 3px; font-size: 0.62em; }
    .gh-hero__actions { margin-top: 24px; gap: 0; }
    .gh-hero__note + .gh-btn--solid { margin-top: 30px; }
    /* Smaller and centred: at full column width it sat on top of the pricing
       rows in the mobile artwork. */
    .gh-hero .gh-btn--solid { max-width: 220px; padding: 11px 18px; font-size: 13.5px; }
    .gh-hero__inner { text-align: center; }
    .gh-hero__actions { align-items: center; }
    .gh-hero__note { font-size: 9px; letter-spacing: 0.14em; }
    .gh-hero__coords { display: none; }
  }
{% endstylesheet %}

