{%- comment -%}
  Galim Health — Hero
  Full-bleed image + layered dark gradients + faint grid. All copy in one column
  (bottom-right on desktop, bottom-centre on mobile), ordered outcome first:
  what it is -> the promise -> the technology that backs it -> the offer that
  makes it worth booking now. Primary CTA opens the waitlist modal.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign has_image = false
  if s.image != blank or s.image_url != blank
    assign has_image = true
  endif
-%}

<section id="{{ s.anchor_id | default: 'top' }}" class="gh-hero" data-gh-section="hero" style="--gh-hero-h1-max: {{ s.heading_size | default: 52 }}px; --gh-hero-h1-min: {{ s.heading_size_mobile | default: 30 }}px; --gh-hero-tint: {{ s.overlay_strength | default: 45 | divided_by: 100.0 }}; --gh-side-color: {{ s.side_color | default: '#0D3B46' }}; --gh-side-width: {{ s.side_width | default: 22 }}%;">
  {%- liquid
    assign desktop_img = s.image
    assign mobile_img = s.image_mobile
    if mobile_img == blank
      assign mobile_img = desktop_img
    endif
    assign fallback_src = ''
    if desktop_img != blank
      assign fallback_src = desktop_img | image_url: width: 2400
    elsif s.image_url != blank
      assign fallback_src = s.image_url
    elsif s.image_url_mobile != blank
      assign fallback_src = s.image_url_mobile
    else
      assign fallback_src = 'hero-large.jpg' | asset_url
    endif
  -%}
  <div class="gh-hero__media">
    {%- comment -%} Blurred copy of the image fills the sides edge-to-edge so the
      contained (full) figure never shows a seam against the background. {%- endcomment -%}
    {%- if fallback_src != blank -%}
      <div class="gh-hero__backdrop" aria-hidden="true" style="background-image: url({{ fallback_src }});"></div>
    {%- endif -%}
    {%- if desktop_img != blank or mobile_img != blank or fallback_src != blank -%}
      <picture>
        {%- comment -%} Mobile: portrait-ish, retina-ready (up to ~3x of 800px) {%- endcomment -%}
        {%- if mobile_img != blank -%}
          <source
            media="(max-width: 767px)"
            srcset="{{ mobile_img | image_url: width: 800 }} 800w, {{ mobile_img | image_url: width: 1200 }} 1200w, {{ mobile_img | image_url: width: 1600 }} 1600w"
            sizes="100vw">
        {%- elsif s.image_url_mobile != blank -%}
          <source media="(max-width: 767px)" srcset="{{ s.image_url_mobile }}">
        {%- endif -%}
        {%- comment -%} Desktop: full-bleed, retina-ready up to 3200w {%- endcomment -%}
        {%- if desktop_img != blank -%}
          <source
            media="(min-width: 768px)"
            srcset="{{ desktop_img | image_url: width: 1600 }} 1600w, {{ desktop_img | image_url: width: 2000 }} 2000w, {{ desktop_img | image_url: width: 2600 }} 2600w, {{ desktop_img | image_url: width: 3200 }} 3200w"
            sizes="100vw">
        {%- elsif s.image_url != blank -%}
          <source media="(min-width: 768px)" srcset="{{ s.image_url }}">
        {%- endif -%}
        <img class="gh-hero__img" src="{{ fallback_src }}" alt="{{ s.image.alt | escape | default: shop.name }}" loading="eager" fetchpriority="high" decoding="async" onerror="this.style.display='none'">
      </picture>
    {%- endif -%}
    <div class="gh-hero__tint"></div>
    <div class="gh-hero__grad-h"></div>
    <div class="gh-hero__grad-v"></div>
    <div class="gh-hero__grid"></div>
    <div class="gh-hero__sides" aria-hidden="true"></div>
  </div>

  <div class="gh-hero__inner">
    <div class="gh-hero__col">
      {%- if s.badge != blank -%}
        <div class="gh-hero__badge">
          <span class="gh-hero__dot"></span>{{ s.badge }}
        </div>
      {%- endif -%}

      {%- if s.heading != blank or s.heading_accent != blank -%}
        <h1 class="gh-hero__h1">
          {{- s.heading | newline_to_br -}}
          {%- if s.heading_accent != blank -%}
            {%- if s.heading != blank -%}<br>{%- endif -%}
            <span class="gh-hero__h1-accent">{{ s.heading_accent }}</span>
          {%- endif -%}
        </h1>
      {%- endif -%}

      {%- if s.subheading != blank -%}
        <p class="gh-hero__sub">{{ s.subheading }}</p>
      {%- endif -%}

      {%- if s.council_line != blank -%}
        <p class="gh-hero__council">{{ s.council_line }}</p>
      {%- endif -%}

      {%- comment -%}
        "Why book today" group: the launch stamp and the founding-member price
        table read as one offer, separated from the pitch above by a hairline.
        COMING SOON / the date used to be a display headline floating on its own
        over the figure, which made the announcement — not the customer's
        outcome — the biggest thing on the page. Here it's the dated reason to
        act on the offer it sits with. It also drops the old aria-hidden: the
        opening date is information, not decoration.
      {%- endcomment -%}
      {%- if s.coming_soon != blank or section.blocks.size > 0 -%}
        <div class="gh-hero__offer">
          {%- if s.coming_soon != blank -%}
            <p class="gh-hero__stamp">
              <span class="gh-hero__stamp-label">{{ s.coming_soon }}</span>
              {%- if s.coming_soon_sub != blank -%}
                <span class="gh-hero__stamp-date">{{ s.coming_soon_sub }}</span>
              {%- endif -%}
            </p>
          {%- endif -%}

          {%- if section.blocks.size > 0 -%}
            <div class="gh-hero__plans">
              {%- for block in section.blocks -%}
                {%- if block.type == 'plan' -%}
                  {%- liquid
                    assign plan_href = block.settings.link
                    if plan_href == blank
                      assign plan_href = '#plans'
                    endif
                  -%}
                  <a href="{{ plan_href }}" class="gh-hero__plan" {{ block.shopify_attributes }}>
                    {%- if block.settings.time != blank -%}<span class="gh-hero__plan-time">{{ block.settings.time }}</span>{%- endif -%}
                    {%- if block.settings.name != blank -%}<span class="gh-hero__plan-name">{{ block.settings.name }}</span>{%- endif -%}
                    {%- if block.settings.price != blank -%}<span class="gh-hero__plan-price">{{ block.settings.price }}</span>{%- endif -%}
                  </a>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="gh-hero__actions">
        {%- if s.button_label != blank -%}
          {%- if s.button_opens_modal -%}
            <a href="#" class="gh-btn gh-btn--solid" data-gh-waitlist-open>{{ s.button_label }} →</a>
          {%- else -%}
            <a href="{{ s.button_link | default: '#' }}" class="gh-btn gh-btn--solid">{{ s.button_label }} →</a>
          {%- endif -%}
        {%- endif -%}
        {%- if s.coords != blank -%}
          <span class="gh-hero__coords">{{ s.coords }}</span>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  /* Galim Health — Hero
     Desktop: content bottom-right, 305° diagonal scrim.
     Mobile:  content bottom-left, 180° vertical scrim. */

  .gh-hero {
    position: relative;
    /* Dark island on the light site: keep text/accents light over the photo */
    --gh-light: #F7F5F3;
    --gh-white: #F7F5F3;
    --gh-muted: #A8C2C8;
    --gh-slate: #A8C2C8;
    --gh-green: #A8C2C8;
    --gh-accent: #A8C2C8;
    /* Cinematic hero sized to the 4503×1851 artwork (~2.43:1), but expressed as
       a MINIMUM height rather than aspect-ratio. aspect-ratio fixes the height
       from the width, so the taller copy column would be clipped by the
       overflow:hidden below at the widths where the ratio's height falls under
       the copy's (measured: 15px of headroom left at 1380px). As a minimum, the
       hero keeps the exact ratio whenever the copy fits and grows instead of
       cropping when it doesn't. 41.11vw = 1851/4503. */
    min-height: max(560px, 41.11vw);
    overflow: hidden;
    /* Copy sits bottom-right in normal flow — that's what lets the hero grow. */
    display: flex; justify-content: flex-end; align-items: flex-end;
    padding: 56px;
    /* The theme ships no global border-box reset, so without this min-height
       would size the CONTENT box and the padding would push the hero 112px past
       the ratio. */
    box-sizing: border-box;
    /* Matches the figure image's own teal/green gradient so the (contained)
       photo blends edge-to-edge with no visible letterbox. */
    background:
      radial-gradient(70% 60% at 88% 8%, rgba(92, 178, 74, 0.30), rgba(92, 178, 74, 0) 55%),
      radial-gradient(70% 70% at 8% 96%, rgba(40, 165, 128, 0.26), rgba(40, 165, 128, 0) 55%),
      linear-gradient(135deg, #082B34 0%, #0D3B46 45%, #06222A 100%);
  }
  .gh-hero__media { position: absolute; inset: 0; overflow: hidden; }
  /* Blurred, scaled copy of the same photo — fills the whole hero so the
     contained figure has no visible letterbox/seam on wide screens. */
  .gh-hero__backdrop {
    position: absolute; inset: 0; z-index: 0;
    background-size: cover; background-position: center;
    filter: blur(42px) brightness(0.72) saturate(1.15);
    transform: scale(1.18);
  }
  .gh-hero__img {
    position: absolute; inset: 0; z-index: 1;
    width: 100%; height: 100%;
    /* Show the FULL figure (no crop); the blurred backdrop fills the sides */
    object-fit: contain; object-position: center;
  }
  /* Optional teal tint over the full photo (customizer slider) */
  .gh-hero__tint { position: absolute; inset: 0; background: rgb(13 59 70 / var(--gh-hero-tint, 0.2)); pointer-events: none; }
  /* THE EFFECT: dark scrim anchored to the right (where the copy sits) plus a
     bloom behind the bottom-right block, so text stays readable over the figure. */
  .gh-hero__grad-h {
    position: absolute; inset: 0; pointer-events: none;
    background:
      linear-gradient(270deg, rgba(8, 43, 52, 0.55) 0%, rgba(8, 43, 52, 0) 34%),
      linear-gradient(90deg, rgba(8, 43, 52, 0.45) 0%, rgba(8, 43, 52, 0) 30%);
  }
  .gh-hero__grad-v { position: absolute; inset: 0; display: none; pointer-events: none; }
  .gh-hero__grid { display: none; }

  /* Side fades: brand color at the edges, transparent toward the center */
  .gh-hero__sides { position: absolute; inset: 0; pointer-events: none; z-index: 2; }
  .gh-hero__sides::before,
  .gh-hero__sides::after {
    content: "";
    position: absolute; top: 0; bottom: 0;
    width: var(--gh-side-width, 22%);
    pointer-events: none;
  }
  .gh-hero__sides::before {
    left: 0;
    background: linear-gradient(to right, var(--gh-side-color, #0D3B46), rgba(9,46,43,0));
  }
  .gh-hero__sides::after {
    right: 0;
    background: linear-gradient(to left, var(--gh-side-color, #0D3B46), rgba(9,46,43,0));
  }

  /* Content: absolute bottom-right on desktop. One column, not two competing
     focal points — the copy carries the whole message and the left of the frame
     stays pure image. */
  .gh-hero__inner {
    position: relative; z-index: 4;
    width: 520px; max-width: 100%;
    color: #f6f5ee;
  }
  .gh-hero__col { display: block; }

  /* Launch stamp: the dated reason to act, sized as a caption rather than a
     headline so the outcome above it stays the largest thing in the frame. */
  .gh-hero__stamp {
    display: inline-flex; align-items: center; margin: 0 0 18px; padding: 8px 15px;
    border: 1px solid rgba(255, 255, 255, 0.30); border-radius: 999px;
    font: 500 11px/1 var(--gh-mono); letter-spacing: 0.2em; text-transform: uppercase;
    color: #F7F5F3;
    background: rgba(6, 31, 38, 0.28);
    text-shadow: 0 1px 10px rgba(6, 31, 38, 0.5);
  }
  .gh-hero__stamp-date { color: var(--gh-green); }
  .gh-hero__stamp-date::before { content: "·"; margin: 0 8px; opacity: 0.55; color: #F7F5F3; }

  .gh-hero__badge {
    display: inline-flex; align-items: center; gap: 9px;
    font: 500 12px/1 var(--gh-mono);
    letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--gh-green);
  }
  .gh-hero__dot { width: 6px; height: 6px; border-radius: 50%; background: var(--gh-green); display: inline-block; }

  /* The outcome, and the biggest thing on the page. Tighter leading and tracking
     than before so it reads as one statement at this size instead of a stack of
     loose lines. */
  .gh-hero__h1 {
    margin: 14px 0 0;
    font: 300 clamp(var(--gh-hero-h1-min, 30px), 4.6vw, var(--gh-hero-h1-max, 56px))/1.04 var(--gh-sans);
    letter-spacing: -0.025em;
    color: #f6f5ee;
    text-wrap: balance;
  }
  .gh-hero__h1-accent { font-weight: 500; }
  /* Supporting proof, deliberately a third of the headline's size: the
     technology explains the promise, it doesn't lead it. */
  .gh-hero__sub {
    margin: 18px 0 0; max-width: 400px;
    font: 300 17px/1.55 var(--gh-sans);
    color: rgba(246, 245, 238, 0.78);
  }

  /* Offer group — everything that answers "why book now", fenced off from the
     pitch above by a hairline. */
  .gh-hero__offer {
    margin-top: 26px; padding-top: 22px;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
  }
  .gh-hero__council { display: none; }
  .gh-hero__coords {
    display: inline-block;
    font: 400 12px/1.4 var(--gh-mono);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gh-green);
    padding-left: 14px;
    border-left: 1px solid rgba(174, 191, 152, 0.4);
  }

  /* Plans as a 3-column price table: duration | package | price.
     Every row is a subgrid of the same three tracks, so "25 MIN"/"50 MIN"
     share a left edge and the prices line up in their own column — centring
     each row independently (the old flex layout) left them ragged. */
  .gh-hero__plans {
    list-style: none; margin: 14px 0 0; padding: 0;
    display: grid;
    grid-template-columns: max-content minmax(0, max-content) max-content;
    justify-content: start;
    row-gap: 8px; column-gap: 18px;
    font: 400 12px/1 var(--gh-mono);
    letter-spacing: 0.06em;
    color: rgba(246, 245, 238, 0.75);
  }
  .gh-hero__plan {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    align-items: baseline;
    color: inherit;
    transition: color 0.2s ease;
  }
  .gh-hero__plan:hover { color: #f6f5ee; }
  /* Explicit tracks: a row that omits its duration must leave that cell empty
     rather than sliding the package name into the first column. */
  /* text-align:left is explicit because the mobile hero centres its copy, which
     would otherwise centre each cell inside its track and undo the alignment. */
  .gh-hero__plan-time { grid-column: 1; text-align: left; color: var(--gh-green); text-transform: uppercase; white-space: nowrap; }
  .gh-hero__plan-name { grid-column: 2; text-align: left; color: inherit; text-transform: uppercase; }
  /* Prices flush right so they end on a shared edge whatever their length. */
  .gh-hero__plan-price { grid-column: 3; color: inherit; white-space: nowrap; text-align: right; }
  /* No `·` separators: once the parts sit in real columns the dots read as
     column dividers and strand a gap between a short package name and its
     price. The column gutters do the separating now. */

  /* Safari <16 has no subgrid: `grid-template-columns: subgrid` is dropped and
     each row would collapse to one column, stacking duration/name/price on
     three lines. Fall back to the previous inline row — unaligned, but intact. */
  @supports not (grid-template-columns: subgrid) {
    .gh-hero__plans { display: flex; flex-direction: column; align-items: flex-start; }
    .gh-hero__plan { display: flex; flex-wrap: wrap; align-items: baseline; column-gap: 10px; }
    .gh-hero__plan-name:only-child { width: auto; min-width: 0; }
  }

  /* Note-style chip: when the name is the chip's ONLY part (no time, no price)
     it's a sentence, not a label — so tighten the tracking and size it down a
     touch to hold ONE row. Measured at 375px (335px usable): the sentence is
     337px at 11px with the default 0.06em tracking (2px too wide), but ~310px
     at 0.01em. Scales with the viewport so it also fits 320px phones.
     Selector is semantic, not positional, so reordering chips can't break it. */
  .gh-hero__plan-name:only-child {
    font-size: min(11.5px, 3vw);
    letter-spacing: 0.01em;
    white-space: nowrap;
    /* Spans the whole table so a label/footnote row isn't squeezed into the
       package column. width:0 + min-width:100% keeps its text OUT of the
       intrinsic sizing of the three tracks: a long sentence would otherwise
       stretch them and blow the gutters open on the priced rows. */
    grid-column: 1 / -1;
    width: 0;
    min-width: 100%;
  }

  /* Solid cream button */
  .gh-hero__actions { display: flex; gap: 18px; align-items: center; flex-wrap: wrap; margin-top: 24px; }
  .gh-hero .gh-btn--solid {
    background: #F7F5F3;
    color: #135E73;
    padding: 16px 30px;
    border-radius: 999px;
    font: 500 16px/1 var(--gh-sans);
    letter-spacing: 0.02em;
    text-shadow: none;
  }
  .gh-hero .gh-btn--solid:hover { background: #FFFFFF; color: #0F4E60; }

  /* MOBILE (5c): vertical scrim + bottom-left content */
  @media (max-width: 768px) {
    /* One column of copy anchored to the bottom, image above it. flex-end, not
       space-between: the copy is now the only child in flow, so space-between
       would pin it to the top of the frame. */
    .gh-hero { min-height: 82svh; min-height: 82vh; flex-direction: column; justify-content: flex-end; align-items: center; text-align: center; padding: 40px 20px 28px; }
    /* Mobile uses the portrait image, cropped to fill (cover) — no backdrop */
    .gh-hero__backdrop { display: none; }
    .gh-hero__img { object-fit: cover; object-position: 50% 25%; }
    .gh-hero__tint { display: none; }
    .gh-hero__grad-h { display: none; }
    /* Narrower side fades on mobile so the photo shows more */
    .gh-hero__sides::before,
    .gh-hero__sides::after { width: 12%; }
    /* Vertical scrim. Ramps up from ~40% — where the copy block starts — so the
       text never sits on the bright contour lines of the figure. */
    .gh-hero__grad-v {
      display: block;
      background: linear-gradient(180deg,
        rgba(8, 43, 52, 0.55) 0%,
        rgba(8, 43, 52, 0.12) 24%,
        rgba(8, 43, 52, 0.55) 44%,
        rgba(8, 43, 52, 0.86) 60%,
        rgba(8, 43, 52, 0.96) 100%);
    }
    /* Both blocks static so they stack instead of overlapping */
    .gh-hero__inner {
      width: 100%; max-width: none;
      text-align: center;
    }
    /* Soft halo directly behind the copy block: lifts the text off the figure
       without drawing a visible box. */
    .gh-hero__inner::before {
      content: "";
      position: absolute; left: -20px; right: -20px; top: -34px; bottom: -20px;
      /* Stronger than before: the copy block is taller now, so its top edge sits
         higher up the figure where the contour lines are still bright. */
      background: radial-gradient(74% 66% at 50% 52%, rgba(6, 31, 38, 0.72), rgba(6, 31, 38, 0) 74%);
      filter: blur(6px);
      pointer-events: none;
      z-index: -1;
    }
    .gh-hero__badge { justify-content: center; margin-bottom: 0; font-size: 10px; }
    /* Scales down on narrow phones instead of running into the edges. Now the
       dominant element — the old size (25-30px) sat below COMING SOON's 34-52px,
       which buried the outcome under the announcement. */
    .gh-hero__h1 { font-size: clamp(30px, 8.8vw, 38px); line-height: 1.06; margin-top: 10px; text-shadow: 0 2px 20px rgba(6, 31, 38, 0.5); }
    /* Slightly narrower measure = fewer, better-balanced lines */
    .gh-hero__sub { font-size: 14.5px; line-height: 1.5; margin: 13px auto 0; max-width: 300px; text-shadow: 0 1px 14px rgba(6, 31, 38, 0.65); }
    .gh-hero__offer { margin-top: 20px; padding-top: 17px; }
    .gh-hero__stamp { margin: 0 auto 4px; padding: 7px 13px; font-size: 10px; letter-spacing: 0.18em; }
    /* The table itself is centred in the hero, but its rows stay left-aligned
       inside it — that's what keeps "25 MIN" and "50 MIN" on a shared edge
       instead of each row being centred on its own width. */
    .gh-hero__plans {
      justify-content: center;
      row-gap: 7px; column-gap: 10px; margin: 13px 0 0;
      max-width: 100%;
      /* Sized so the longest row holds ONE line from 360px up (measured: 330px
         of table in 335px of usable width at 375px). Below that the package
         column is allowed to shrink and wrap rather than be clipped by the
         hero's overflow:hidden. */
      font-size: clamp(10px, 3vw, 11.5px);
      text-shadow: 0 1px 12px rgba(6, 31, 38, 0.7);
    }
    /* Label/footnote rows read as centred captions above and below the table. */
    .gh-hero__plan-name:only-child { text-align: center; }
    .gh-hero__actions { justify-content: center; margin-top: 20px; }
    .gh-hero .gh-btn--solid { width: 100%; justify-content: center; }
    .gh-hero__coords { display: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Galim · Hero",
  "class": "gh-section-full",
  "settings": [
    { "type": "header", "content": "Background image" },
    { "type": "image_picker", "id": "image", "label": "Hero image (desktop)" },
    { "type": "text", "id": "image_url", "label": "…or desktop image URL", "info": "Used if no image is uploaded. Falls back to a dark panel.", "default": "https://galimhealth.com/cdn/shop/files/Escena_65.png?v=1784139814&width=1600" },
    { "type": "image_picker", "id": "image_mobile", "label": "Hero image (mobile)", "info": "Shown below 768px. If empty, the desktop image is used." },
    { "type": "text", "id": "image_url_mobile", "label": "…or mobile image URL" },
    { "type": "range", "id": "overlay_strength", "min": 0, "max": 90, "step": 5, "unit": "%", "label": "Image overlay strength (desktop)", "info": "Teal tint over the whole photo. Keep low so the photo shows; the diagonal scrim already darkens the text side.", "default": 20 },
    { "type": "color", "id": "side_color", "label": "Side fade color", "info": "Color that fades in from the left and right edges over the photo.", "default": "#0D3B46" },
    { "type": "range", "id": "side_width", "min": 0, "max": 40, "step": 2, "unit": "%", "label": "Side fade width", "default": 22 },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "anchor_id", "label": "Anchor id", "default": "top" },
    { "type": "range", "id": "heading_size", "min": 36, "max": 88, "step": 2, "unit": "px", "label": "Heading size (desktop)", "default": 64 },
    { "type": "range", "id": "heading_size_mobile", "min": 22, "max": 46, "step": 2, "unit": "px", "label": "Heading size (mobile)", "default": 38 },
    { "type": "text", "id": "coming_soon", "label": "Coming soon (big, left)", "info": "Large statement on the empty side of the hero. Leave blank to hide.", "default": "COMING SOON" },
    { "type": "text", "id": "coming_soon_sub", "label": "Coming soon subline", "default": "NOVEMBER 1ST" },
    { "type": "text", "id": "badge", "label": "Badge (mono)", "default": "PREVENTIVE HEALTHCARE · MEDICAL COUNCIL" },
