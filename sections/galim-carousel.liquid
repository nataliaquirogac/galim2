{%- comment -%}
  Galim Health — What we measure (tab-based photo navigator)
  One shared row of tabs (one per measurement system); selecting a tab
  shows/hides its panel below. A panel is purely the photo — no name,
  no description, no card, no overlay text of any kind. The container
  keeps the full photo (no crop): an <img> at its natural proportions
  rather than a cropped background-image tile.

  Each block has independent desktop/mobile photos (<picture> + a
  max-width: 767px <source>), same idea as the hero's image/image_mobile
  pair — a photo cropped for a wide frame rarely reads the same way in a
  narrow one, so this lets her upload a differently-cropped version for
  mobile per system instead of one photo stretched across both. Photo
  fields left blank render as a transparent tile — no placeholder color,
  no text — ready for one to be uploaded via the customizer.
{%- endcomment -%}

{%- liquid
  assign items = section.blocks | where: 'type', 'item'
  assign primary_count = 5
-%}

<section class="gh-mq gh-section" data-gh-section="carousel">
  <div class="gh-container">
    {%- if items.size > 0 -%}
      {%- comment -%} ---------------- Shared tab row ---------------- {%- endcomment -%}
      <div class="gh-mq__tabs-wrap">
        <div class="gh-mq__tabs" data-gh-mq-tabs role="tablist" aria-label="Body systems">
          {%- for block in items -%}
            {%- assign b = block.settings -%}
            {%- if forloop.index0 < primary_count -%}
              <button type="button" class="gh-mq__tab" data-gh-mq-tab data-gh-mq-index="{{ forloop.index0 }}" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" {{ block.shopify_attributes }}>{{ b.name }}</button>
            {%- endif -%}
          {%- endfor -%}
          {%- if items.size > primary_count -%}
            {%- assign more_count = items.size | minus: primary_count -%}
            <button type="button" class="gh-mq__tab gh-mq__tab--more" data-gh-mq-more aria-expanded="false" aria-haspopup="listbox">+{{ more_count }} more</button>
          {%- endif -%}
        </div>

        {%- if items.size > primary_count -%}
          <div class="gh-mq__overlay" data-gh-mq-overlay hidden>
            <ul class="gh-mq__overlay-list" role="listbox">
              {%- for block in items -%}
                {%- assign b = block.settings -%}
                {%- if forloop.index0 >= primary_count -%}
                  <li>
                    <button type="button" class="gh-mq__overlay-item" data-gh-mq-tab data-gh-mq-index="{{ forloop.index0 }}" role="option">{{ b.name }}</button>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} ---------------- Panels: photo only ---------------- {%- endcomment -%}
      <div class="gh-mq__panels">
        {%- for block in items -%}
          {%- assign b = block.settings -%}
          <div class="gh-mq__panel" data-gh-mq-panel data-gh-mq-index="{{ forloop.index0 }}" {% unless forloop.first %}hidden{% endunless %} {{ block.shopify_attributes }}>
            <div class="gh-mq__image">
              {%- if b.image != blank or b.image_mobile != blank -%}
                <picture>
                  {%- if b.image_mobile != blank -%}
                    <source media="(max-width: 767px)" srcset="{{ b.image_mobile | image_url: width: 800 }} 800w, {{ b.image_mobile | image_url: width: 1200 }} 1200w">
                  {%- endif -%}
                  {%- if b.image != blank -%}
                    <img src="{{ b.image | image_url: width: 1600 }}" width="{{ b.image.width }}" height="{{ b.image.height }}" alt="{{ b.name }}" loading="lazy">
                  {%- else -%}
                    <img src="{{ b.image_mobile | image_url: width: 1600 }}" width="{{ b.image_mobile.width }}" height="{{ b.image_mobile.height }}" alt="{{ b.name }}" loading="lazy">
                  {%- endif -%}
                </picture>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  /* No overflow: hidden — this section has nothing that needs clipping in
     the current design (no ambient glow/decoration bleeding past its
     edges), and it would otherwise break both the sticky tab bar below and
     the "+N more" overlay, which needs to visibly extend past the tab row. */
  .gh-mq { position: relative; padding: var(--gh-pad-y) 0; background: #FBFAF8; }
  /* Full viewport width — the rest of the site's .gh-container caps out at
     --gh-max (1440px) and centers with dead space either side on wider
     screens; this section deliberately breaks out of that so the photo
     always fills the actual screen width. Side gutter (--gh-pad-x) stays
     so rounded corners never sit flush against the literal edge. */
  .gh-mq .gh-container { max-width: none; padding: 0 var(--gh-pad-x); }

  /* ---------------- Tabs ---------------- */
  .gh-mq__tabs-wrap { position: relative; }
  /* Desktop only, per her request: pinned as a solid bar while scrolling so
     it's always reachable without ever sitting on top of the photo. Offset
     (not top: 0) clears the site's own floating pill header — measured live
     at ~67px tall once condensed/scrolled, so 88px leaves it a clean ~20px
     gap instead of overlapping it. Solid background (not transparent) is
     what makes it read as a bar rather than the tabs just floating over
     whatever photo is currently scrolling underneath. */
  @media (min-width: 769px) {
    .gh-mq__tabs-wrap {
      position: sticky;
      top: 88px;
      z-index: 20;
      background: #FBFAF8;
    }
  }
  .gh-mq__tabs {
    display: flex; align-items: flex-end; gap: 36px;
    overflow-x: auto; overflow-y: hidden;
    white-space: nowrap;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--gh-hairline);
  }
  .gh-mq__tabs::-webkit-scrollbar { display: none; }
  .gh-mq__tab {
    position: relative;
    flex: 0 0 auto;
    background: none; border: 0; padding: 0 0 16px; margin: 0 0 -17px;
    font: 300 22px/1 var(--gh-sans); color: var(--gh-slate);
    cursor: pointer;
    transition: color 0.25s ease;
  }
  .gh-mq__tab:hover { color: var(--gh-light); }
  .gh-mq__tab[aria-selected="true"] { color: var(--gh-brand); font-weight: 500; }
  /* Short, thick indicator centred under the label — not full tab width. */
  .gh-mq__tab[aria-selected="true"]::after {
    content: ""; position: absolute; left: 50%; bottom: 0;
    transform: translateX(-50%);
    width: 28px; height: 3px; border-radius: 2px;
    background: var(--gh-brand);
  }
  .gh-mq__tab--more { color: var(--gh-slate); font: 300 16px/1 var(--gh-mono); letter-spacing: 0.04em; }
  .gh-mq__tab--more:hover { color: var(--gh-brand); }
  /* Set via JS when a finger-swipe lands on one of the "+N more" systems,
     which has no tab button of its own to mark active. */
  .gh-mq__tab--more.is-active { color: var(--gh-brand); font-weight: 500; }
  .gh-mq__tab--more.is-active::after {
    content: ""; position: absolute; left: 50%; bottom: 0;
    transform: translateX(-50%);
    width: 28px; height: 3px; border-radius: 2px;
    background: var(--gh-brand);
  }

  .gh-mq__overlay {
    position: absolute; z-index: 5; top: 100%; right: var(--gh-pad-x); margin-top: 8px;
    background: #FFFFFF; border: 1px solid var(--gh-border); border-radius: 14px;
    box-shadow: 0 20px 50px rgba(13, 59, 70, 0.16);
    padding: 10px; min-width: 220px; max-height: 320px; overflow-y: auto;
  }
  .gh-mq__overlay[hidden] { display: none; }
  .gh-mq__overlay-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2px; }
  .gh-mq__overlay-item {
    display: block; width: 100%; text-align: left;
    background: none; border: 0; border-radius: 8px; padding: 10px 12px;
    font: 300 15px/1.2 var(--gh-sans); color: var(--gh-light); cursor: pointer;
  }
  .gh-mq__overlay-item:hover { background: var(--gh-light-tint); color: var(--gh-brand); }

  /* ---------------- Panel: just the photo, full container, no crop ---------------- */
  @keyframes gh-mq-fade { from { opacity: 0; } to { opacity: 1; } }
  .gh-mq__panel[hidden] { display: none; }
  .gh-mq__panel:not([hidden]) { animation: gh-mq-fade 0.4s ease; }
  .gh-mq__panel { padding-top: 40px; }
  .gh-mq__image {
    width: 100%;
    min-height: 320px;
    border-radius: 20px;
    overflow: hidden;
    background: transparent;
  }
  .gh-mq__image img { display: block; width: 100%; height: auto; }

  @media (max-width: 768px) {
    .gh-mq__tabs { gap: 24px; }
    .gh-mq__tab { font-size: 17px; padding-bottom: 12px; margin-bottom: -13px; }
    .gh-mq__tab--more { font-size: 13px; }
    .gh-mq__overlay { left: 20px; right: 20px; min-width: 0; }
    .gh-mq__panel { padding-top: 24px; }
    .gh-mq__image { border-radius: 18px; min-height: 260px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Galim · Carousel",
  "class": "gh-section-full",
  "blocks": [
    {
      "type": "item",
      "name": "Measurement",
      "settings": [
        { "type": "text", "id": "name", "label": "Name (tab label)", "default": "Vision" },
        { "type": "image_picker", "id": "image", "label": "Photo (desktop)" },
        { "type": "image_picker", "id": "image_mobile", "label": "Photo (mobile)", "info": "Shown below 768px instead of the desktop photo. Leave blank to reuse the desktop photo on mobile too." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Galim · Carousel",
      "blocks": [
        { "type": "item", "settings": { "name": "Heart" } },
        { "type": "item", "settings": { "name": "Skin" } },
        { "type": "item", "settings": { "name": "Strength" } },
        { "type": "item", "settings": { "name": "Brain" } },
        { "type": "item", "settings": { "name": "Blood" } },
        { "type": "item", "settings": { "name": "Vision" } },
        { "type": "item", "settings": { "name": "Hearing" } },
        { "type": "item", "settings": { "name": "Lung function" } },
        { "type": "item", "settings": { "name": "Mobility & balance" } },
        { "type": "item", "settings": { "name": "Gut" } }
      ]
    }
  ]
}
{% endschema %}
