        { "type": "text", "id": "addon_title", "label": "Add-ons title (mono)", "default": "ADD-ONS" },
        { "type": "textarea", "id": "addon_line", "label": "Add-ons (one per line, optional)", "default": "RMR — $700 — your real calorie number\nLactate Threshold — $1,300 — your exact training zones\nGalim AI — your plan, adjusted daily" },
