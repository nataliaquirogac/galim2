{%- comment -%}
  Galim Health — 03 / PROTOCOLS
  Two package cards (repeatable blocks) + full-width GLP-1 note. No booking button.
{%- endcomment -%}

{%- liquid assign s = section.settings -%}

<section id="{{ s.anchor_id | default: 'plans' }}" class="gh-protocols gh-section" data-gh-section="protocols" style="background: {{ s.bg_color }};">
  <div class="gh-container">
    {%- if s.eyebrow != blank -%}<p class="gh-eyebrow gh-protocols__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
    {%- if s.heading != blank -%}<h2 class="gh-protocols__h2">{{ s.heading }}</h2>{%- endif -%}

    <div class="gh-protocols__cards">
      {%- for block in section.blocks -%}
        {%- if block.type == 'package' -%}
          {%- assign b = block.settings -%}
          <div class="gh-pkg" {{ block.shopify_attributes }}>
            {%- comment -%}
              Collapsed by default: name, price, included note, subtitle and
              the tag pills. Everything else lives in the panel below,
              revealed on click.
            {%- endcomment -%}
            <button type="button" class="gh-pkg__head" data-gh-pkg-toggle aria-expanded="false">
              <div class="gh-pkg__toprow">
                {%- if b.name != blank -%}<h3 class="gh-pkg__name">{{ b.name }}</h3>{%- endif -%}
                {%- if b.price != blank -%}<div class="gh-pkg__price">{{ b.price }} <span class="gh-pkg__unit">{{ b.price_unit }}</span></div>{%- endif -%}
              </div>
              {%- if b.included_note != blank -%}<p class="gh-pkg__included">{{ b.included_note }}</p>{%- endif -%}
              {%- if b.subtitle != blank -%}<div class="gh-pkg__subtitle">{{ b.subtitle }}</div>{%- endif -%}
              {%- if b.tags != blank -%}
                <div class="gh-pkg__tags">
                  {%- assign tag_rows = b.tags | newline_to_br | split: '<br />' -%}
                  {%- for row in tag_rows -%}
                    {%- assign row_clean = row | strip_html | strip -%}
                    {%- if row_clean != blank -%}<span class="gh-pkg__tag">{{ row_clean }}</span>{%- endif -%}
                  {%- endfor -%}
                </div>
              {%- endif -%}
              <span class="gh-pkg__plus" aria-hidden="true">+</span>
            </button>
            <div class="gh-pkg__collapse" data-gh-pkg-panel>
              <div class="gh-pkg__collapse-inner">
                <div class="gh-pkg__body">
                  {%- if b.intro != blank -%}<p class="gh-pkg__intro">{{ b.intro }}</p>{%- endif -%}

                  {%- if b.features != blank -%}
                    <div class="gh-pkg__section">
                      <div class="gh-pkg__label">{{ b.features_label | default: 'WHAT WE MEASURE' }}</div>
                      <div class="gh-pkg__features">{{ b.features }}</div>
                    </div>
                  {%- endif -%}

                  {%- if b.outro != blank -%}<div class="gh-pkg__note">{{ b.outro }}</div>{%- endif -%}

                  {%- if b.addon_line != blank -%}
                    <div class="gh-pkg__section gh-pkg__addons">
                      <div class="gh-pkg__label gh-pkg__label--muted">{{ b.addon_title | default: 'ADD-ONS' }}</div>
                      <div class="gh-pkg__addon-list">
                        {%- assign addon_rows = b.addon_line | newline_to_br | split: '<br />' -%}
                        {%- for row in addon_rows -%}
                          {%- assign row_clean = row | strip_html | strip -%}
                          {%- if row_clean != blank -%}
                            {%- if row_clean contains '$' -%}
                              {%- assign gh_price = row_clean | split: '$' | last | strip -%}
                              {%- assign gh_text = row_clean | split: '$' | first | strip -%}
                              <div class="gh-pkg__addon">
                                <span class="gh-pkg__addon-price">+${{ gh_price }}</span>
                                <span class="gh-pkg__addon-text">{{ gh_text }}</span>
                              </div>
                            {%- else -%}
                              <div class="gh-pkg__addon">
                                <span class="gh-pkg__addon-text">{{ row_clean }}</span>
                              </div>
                            {%- endif -%}
                          {%- endif -%}
                        {%- endfor -%}
                      </div>
                    </div>
                  {%- endif -%}

                  {%- if b.button_label != blank -%}
                    {%- if b.button_link != blank -%}
                      <a href="{{ b.button_link }}" class="gh-btn gh-btn--solid gh-pkg__cta">{{ b.button_label }}</a>
                    {%- else -%}
                      <a href="#" class="gh-btn gh-btn--solid gh-pkg__cta" data-gh-waitlist-open>{{ b.button_label }}</a>
                    {%- endif -%}
                  {%- endif -%}
                </div>
              </div>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if s.glp_title != blank or s.glp_body != blank -%}
      <div class="gh-glp">
        {%- if s.glp_glyph != blank -%}<span class="gh-glp__glyph">{{ s.glp_glyph }}</span>{%- endif -%}
        <div>
          {%- if s.glp_title != blank -%}<p class="gh-glp__title">{{ s.glp_title }}</p>{%- endif -%}
          {%- if s.glp_body != blank -%}<div class="gh-glp__body">{{ s.glp_body }}</div>{%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .gh-protocols__eyebrow { margin-bottom: 12px; text-align: center; }
  .gh-protocols__h2 { font: 200 44px/1.14 var(--gh-mono); letter-spacing: -0.02em; color: var(--gh-white); margin: 0 auto 36px; max-width: 900px; text-align: center; }
  .gh-protocols__h2 p { margin: 0; }
  /* Bold in the heading = animated gradient text using the site's own brand
     ramp (same 4 colors as the gradient-ring borders on buttons/cards). */
  .gh-protocols__h2 strong {
    font-weight: 500;
    background: linear-gradient(90deg, #C9D1C3, #1B88A6 30%, #2AAFDF 60%, #135E73 100%);
    background-size: 200% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    animation: gh-sweep 6s linear infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .gh-protocols__h2 strong { animation: none; }
  }
  /* align-items: start, not the default stretch — each card is now an
     independent accordion, so a collapsed card must stay short next to an
     expanded sibling instead of being stretched to match its height. */
  .gh-protocols__cards { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; align-items: start; }
  .gh-pkg { display: flex; flex-direction: column; }

  /* Package cards = light surface, same recipe as the diagnostics rows. */
  .gh-pkg {
    position: relative; border-radius: 16px; overflow: hidden;
    background: #EDEDED;
    box-shadow: 0 8px 22px rgba(19, 94, 115, 0.10);
    transition: transform 0.3s, box-shadow 0.3s;
  }
  .gh-pkg:hover { transform: translateY(-6px); box-shadow: 0 16px 36px rgba(19, 94, 115, 0.16); }
  /* The collapsed summary is itself the toggle button. */
  .gh-pkg__head {
    position: relative; width: 100%; display: block;
    /* Right padding reserves room for the plus icon, positioned absolutely
       (below) rather than sitting in the row. */
    padding: 28px 56px 44px 30px;
    border: 0; background: none;
    font: inherit; color: inherit; text-align: left; cursor: pointer;
  }
  .gh-pkg__toprow { display: flex; align-items: baseline; gap: 12px; }
  /* Anchored to the bottom of the (variable-height) head — not a fixed
     top offset — so it still sits in the corner once the tag row wraps to
     more than one line. */
  .gh-pkg__plus {
    position: absolute; bottom: 18px; right: 22px;
    font: 300 26px/1 var(--gh-mono); color: var(--gh-brand);
    transition: transform 0.3s ease;
  }
  .gh-pkg__head[aria-expanded="true"] .gh-pkg__plus { transform: rotate(45deg); }

  /* Package titles stay in Chillax (brand display face), thin weight, in the
     mid-teal accent; everything else in the card is DM Sans. */
  .gh-pkg__name {
    flex: 1; min-width: 0;
    font: 300 30px/1.15 var(--gh-sans); color: #1B88A6; margin: 0; padding: 0; letter-spacing: -0.01em;
  }
  .gh-pkg__price { flex: none; white-space: nowrap; font: 500 22px/1 var(--gh-mono); color: var(--gh-brand); letter-spacing: 0; }
  .gh-pkg__unit { font-size: 12px; }
  .gh-pkg__included { font: 400 italic 14px/1.4 var(--gh-mono); color: var(--gh-muted); margin: 10px 0 0; padding: 0; }
  .gh-pkg__subtitle { font: 400 16px/1.4 var(--gh-mono); color: var(--gh-muted); margin: 14px 0 0; padding: 0; }
  .gh-pkg__subtitle strong { font-weight: 700; color: var(--gh-light); }
  /* Tag pills — the compact preview of what's measured, always visible. */
  .gh-pkg__tags { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px; }
  .gh-pkg__tag {
    font: 500 13px/1 var(--gh-mono); color: #FFFFFF; background: #0D3B46;
    padding: 10px 16px; border-radius: 999px; white-space: nowrap;
  }

  /* Collapsible panel: grid-template-rows 0fr -> 1fr animates height without
     JS measuring scrollHeight. The inner wrapper clips overflow during the
     transition; the fade+lift on gh-pkg__body is what reads as content
     arriving "little by little" rather than the panel just snapping open. */
  .gh-pkg__collapse {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .gh-pkg__collapse.is-open { grid-template-rows: 1fr; }
  .gh-pkg__collapse-inner { overflow: hidden; min-height: 0; }
  .gh-pkg__body {
    padding: 0 30px 30px; flex: 1; display: flex; flex-direction: column;
    opacity: 0; transform: translateY(-6px);
    transition: opacity 0.35s ease, transform 0.35s ease;
  }
  .gh-pkg__collapse.is-open .gh-pkg__body { opacity: 1; transform: none; transition-delay: 0.1s; }
  /* Lead line */
  .gh-pkg__intro { font: 400 16px/1.5 var(--gh-mono); color: #1B88A6; margin: 0 0 20px; }
  /* Each block is a labelled section split by a hairline divider */
  .gh-pkg__section { padding-top: 18px; border-top: 1px solid var(--gh-hairline); margin-bottom: 18px; }
  .gh-pkg__label { font: 700 12px/1 var(--gh-mono); letter-spacing: 0.14em; text-transform: uppercase; color: var(--gh-brand); margin-bottom: 16px; }
  .gh-pkg__label--muted { color: var(--gh-slate); font-weight: 500; }
  /* Feature rows: bold dark term, description under it in the teal accent */
  .gh-pkg__features ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 16px; }
  .gh-pkg__features li { font: 400 15px/1.4 var(--gh-mono); color: #1B88A6; padding: 0; }
  .gh-pkg__features strong { display: block; font: 700 16px/1.3 var(--gh-mono); color: var(--gh-light); margin-bottom: 3px; }
  .gh-pkg__features p { margin: 0; }
  /* Highlighted takeaway callout — solid fill, not a translucent overlay. */
  .gh-pkg__note {
    background: #0B6E8A; border-radius: 12px;
    padding: 18px 20px; margin-bottom: 18px;
    display: flex; flex-direction: column; gap: 8px;
  }
  .gh-pkg__note p { font: 400 14px/1.5 var(--gh-mono); color: #FFFFFF; margin: 0; }
  .gh-pkg__note p:first-child { font-weight: 700; }
  /* Add-ons: bold price on the left, description filling the rest */
  .gh-pkg__addons { margin-bottom: 22px; }
  .gh-pkg__addon-list { display: flex; flex-direction: column; gap: 14px; }
  .gh-pkg__addon { display: flex; gap: 18px; align-items: baseline; }
  .gh-pkg__addon-price { flex: none; width: 76px; font: 700 15px/1.3 var(--gh-mono); color: var(--gh-brand); }
  .gh-pkg__addon-text { font: 400 14px/1.4 var(--gh-mono); color: var(--gh-muted); }
  /* Solid CTA in the same teal as the BQ callout */
  .gh-pkg__cta { width: 100%; justify-content: center; margin-top: auto; font: 500 15px/1 var(--gh-sans); letter-spacing: 0.02em; padding: 16px 24px; }
  .gh-pkg .gh-btn--solid { background: #0B6E8A; }
  .gh-pkg .gh-btn--solid:hover { background: #095A72; }

  .gh-glp {
    margin-top: 28px; border-radius: 14px; background: rgba(19,94,115,.06);
    border: 1px solid rgba(19,94,115,.2); padding: 32px 36px;
    display: flex; gap: 22px; align-items: flex-start;
  }
  .gh-glp__glyph { font: 400 30px/1 var(--gh-mono); color: var(--gh-green); flex-shrink: 0; }
  .gh-glp__title { font: 500 20px/1.4 var(--gh-mono); color: var(--gh-white); margin-bottom: 12px; }
  .gh-glp__body, .gh-glp__body p { font: 400 17px/1.6 var(--gh-mono); color: var(--gh-light); max-width: 820px; margin: 0; }
  .gh-glp__body strong { font-weight: 600; color: var(--gh-green); }

  @media (max-width: 768px) {
    .gh-protocols__h2 { font-size: 30px; margin-bottom: 24px; }
    .gh-protocols__cards { grid-template-columns: 1fr; gap: 16px; }
    .gh-pkg:hover { transform: none; }
    .gh-pkg__head { padding: 22px 46px 36px 20px; }
    .gh-pkg__name { font-size: 24px; }
    .gh-pkg__price { font-size: 18px; }
    .gh-pkg__unit { font-size: 11px; }
    .gh-pkg__tags { gap: 8px; margin-top: 14px; }
    .gh-pkg__tag { font-size: 12px; padding: 8px 13px; }
    .gh-pkg__body { padding: 0 20px 22px; }
    .gh-pkg__addon { flex-direction: column; gap: 4px; }
    .gh-pkg__addon-price { width: auto; }
    .gh-glp { padding: 26px; gap: 0; flex-direction: column; }
    .gh-glp__glyph { display: none; }
    .gh-glp__title { font-size: 18px; margin-bottom: 10px; }
    .gh-glp__body, .gh-glp__body p { font-size: 15px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Galim · Protocols",
  "class": "gh-section-full",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor id", "default": "plans" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "03 / PROTOCOLS" },
    { "type": "richtext", "id": "heading", "label": "Heading (bold = animated gradient)", "default": "<p>Choose your measurement.</p>" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#0A2F38" },
    { "type": "header", "content": "GLP-1 note" },
    { "type": "text", "id": "glp_glyph", "label": "Glyph", "default": "◈" },
    { "type": "text", "id": "glp_title", "label": "Title", "default": "¿Estás en GLP-1?" },
    { "type": "richtext", "id": "glp_body", "label": "Body (bold = green)", "default": "<p>Hasta el <strong>40% de lo que bajas puede ser músculo.</strong> El InBody de tu gym te da un número — estimado. Justo cuando bajas rápido es cuando más se equivoca. Performance mide lo que de verdad perdiste: grasa o tu base. Antes de empezar, y otra vez a las 8 semanas.</p>" }
  ],
  "blocks": [
    {
      "type": "package",
      "name": "Package",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Performance" },
        { "type": "richtext", "id": "subtitle", "label": "Subtitle (under name, bold the duration)", "default": "<p><strong>25 min.</strong> Six systems, one number.</p>" },
        { "type": "text", "id": "included_note", "label": "Included note (italic, under name)", "info": "E.g. \"Includes Body Performance Scan\" — leave blank to hide." },
