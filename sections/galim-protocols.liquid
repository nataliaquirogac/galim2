{%- comment -%}
  Galim Health — 03 / PROTOCOLS
  Two package cards (repeatable blocks) + full-width GLP-1 note. No booking button.
{%- endcomment -%}

{%- liquid assign s = section.settings -%}

<section id="{{ s.anchor_id | default: 'plans' }}" class="gh-protocols gh-section" data-gh-section="protocols" style="background: {{ s.bg_color }};">
  <div class="gh-container">
    {%- if s.eyebrow != blank -%}<p class="gh-eyebrow gh-protocols__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
    {%- if s.heading != blank -%}<h2 class="gh-protocols__h2">{{ s.heading }}</h2>{%- endif -%}

    <div class="gh-protocols__cards">
      {%- for block in section.blocks -%}
        {%- if block.type == 'package' -%}
          {%- assign b = block.settings -%}
          <div class="gh-pkg{% if b.featured %} is-featured{% endif %}" {{ block.shopify_attributes }}>
            {%- if b.featured and b.badge_label != blank -%}<div class="gh-pkg__badge">{{ b.badge_label }}</div>{%- endif -%}
            <div class="gh-pkg__head">
              {%- comment -%}
                Square icon tile above the title. 'none' lets a package opt out
                so a card without a fitting icon doesn't get a filler one.
              {%- endcomment -%}
              {%- unless b.icon == 'none' -%}
                <span class="gh-pkg__icon" aria-hidden="true">
                  {%- case b.icon -%}
                    {%- when 'muscle' -%}{%- render 'icon-muscle', size: 22 -%}
                    {%- when 'heartbeat' -%}{%- render 'icon-heartbeat', size: 22 -%}
                    {%- when 'dna' -%}{%- render 'icon-dna', size: 22 -%}
                    {%- when 'brain' -%}{%- render 'icon-brain', size: 22 -%}
                    {%- when 'lung' -%}{%- render 'icon-lung', size: 22 -%}
                    {%- when 'blood' -%}{%- render 'icon-blood', size: 22 -%}
                    {%- when 'mri' -%}{%- render 'icon-mri', size: 22 -%}
                    {%- when 'microbiome' -%}{%- render 'icon-microbiome', size: 22 -%}
                    {%- when 'balance' -%}{%- render 'icon-balance', size: 22 -%}
                    {%- when 'infinity' -%}{%- render 'icon-infinity', size: 22 -%}
                    {%- when 'pressure' -%}{%- render 'icon-pressure', size: 22 -%}
                    {%- else -%}{%- render 'icon-bolt', size: 22 -%}
                  {%- endcase -%}
                </span>
              {%- endunless -%}
              {%- if b.name != blank -%}<h3 class="gh-pkg__name">{{ b.name }}</h3>{%- endif -%}
              {%- if b.subtitle != blank -%}<p class="gh-pkg__subtitle">{{ b.subtitle }}</p>{%- endif -%}
              {%- if b.price != blank -%}<div class="gh-pkg__price">{{ b.price }} <span class="gh-pkg__unit">{{ b.price_unit }}</span></div>{%- endif -%}
            </div>
            <div class="gh-pkg__body">
              {%- if b.intro != blank -%}<p class="gh-pkg__intro">{{ b.intro }}</p>{%- endif -%}

              {%- if b.features != blank -%}
                <div class="gh-pkg__section">
                  <div class="gh-pkg__label">{{ b.features_label | default: 'WHAT WE MEASURE' }}</div>
                  <div class="gh-pkg__features">{{ b.features }}</div>
                </div>
              {%- endif -%}

              {%- if b.outro != blank -%}<div class="gh-pkg__note">{{ b.outro }}</div>{%- endif -%}

              {%- if b.addon_line != blank -%}
                <div class="gh-pkg__section gh-pkg__addons">
                  <div class="gh-pkg__label">{{ b.addon_title | default: 'ADD-ONS' }}</div>
                  <div class="gh-pkg__addon-list">
                    {%- assign addon_rows = b.addon_line | newline_to_br | split: '<br />' -%}
                    {%- for row in addon_rows -%}
                      {%- assign row_clean = row | strip_html | strip -%}
                      {%- if row_clean != blank -%}<div class="gh-pkg__addon">{{ row_clean }}</div>{%- endif -%}
                    {%- endfor -%}
                  </div>
                </div>
              {%- endif -%}

              {%- if b.button_label != blank -%}
                {%- if b.button_link != blank -%}
                  <a href="{{ b.button_link }}" class="gh-btn gh-btn--solid gh-pkg__cta">{{ b.button_label }} →</a>
                {%- else -%}
                  <a href="#" class="gh-btn gh-btn--solid gh-pkg__cta" data-gh-waitlist-open>{{ b.button_label }} →</a>
                {%- endif -%}
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if s.glp_title != blank or s.glp_body != blank -%}
      <div class="gh-glp">
        {%- if s.glp_glyph != blank -%}<span class="gh-glp__glyph">{{ s.glp_glyph }}</span>{%- endif -%}
        <div>
          {%- if s.glp_title != blank -%}<p class="gh-glp__title">{{ s.glp_title }}</p>{%- endif -%}
          {%- if s.glp_body != blank -%}<div class="gh-glp__body">{{ s.glp_body }}</div>{%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .gh-protocols__eyebrow { margin-bottom: 12px; text-align: center; }
  .gh-protocols__h2 { font: 200 44px/1.14 var(--gh-sans); letter-spacing: -0.02em; color: var(--gh-white); margin: 0 auto 36px; max-width: 900px; text-align: center; }
  .gh-protocols__h2 p { margin: 0; }
  /* Bold in the heading = animated teal -> blue -> gold gradient text. Blue #1E63A8
     comes from the banner's royal-blue family (sampled #0D3880). The gold could
     NOT come from the artwork — sampling it turned up only 3 warm pixels — so it
     is set by contrast instead: every letter passes through every stop as this
     animates, and on the light page a bright yellow like #D9A520 measures 2.01:1,
     under the 3:1 floor for display type. #A97C1F is the most yellow value that
     clears it, at 3.36:1. */
  .gh-protocols__h2 strong {
    font-weight: 500;
    background: linear-gradient(90deg, #135E73, #1E63A8 30%, #A97C1F 58%, #135E73 90%);
    background-size: 200% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    animation: gh-sweep 6s linear infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .gh-protocols__h2 strong { animation: none; }
  }
  /* align-items:stretch (the default) is what makes both cards the height of the
     taller one; `start` had each size to its own content. The card and its body
     are flex columns so the CTA can be pinned to the bottom of that shared
     height — otherwise the shorter card just gains dead space under its button. */
  .gh-protocols__cards { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
  .gh-pkg { display: flex; flex-direction: column; }

  /* Package cards = light glass islands, tuned to the hero's palette */
  .gh-pkg {
    position: relative; border-radius: 16px; overflow: hidden;
    /* Deep and saturated rather than pale — the pastel version read as nursery.
       Cream text, so the card rejoins the rest of the site instead of being the
       one light island. Slate is lifted from #A8C2C8 to #C3D9DD and the price
       from mint to #A5E4F2, because on the lighter teal end the old values fell
       to 3.90:1 and would have failed. */
    --gh-light: #F7F5F3; --gh-white: #F7F5F3; --gh-muted: #CDE0E4; --gh-slate: #C3D9DD;
    --gh-green: #A5E4F2; --gh-accent: #A5E4F2; --gh-price: #A5E4F2;
    /* Flat #135E73 — the brand teal. Every text level clears 4.5:1 on it: cream
       6.7, body 5.4, labels 5.0, price 5.2. */
    /* Gradient ring, same trick and same ramp as the "What we measure" cards:
       the card's own fill clipped to padding-box, the brand ramp clipped to
       border-box behind it, showing through a 3px transparent border. The
       ramp loops back to its own starting color instead of fading to
       transparent, so every edge — including the sides — shows solid color. */
    border: 3px solid transparent;
    background:
      linear-gradient(#135E73, #135E73) padding-box,
      linear-gradient(135deg, #135E73 0%, #2AAFDF 25%, #1B88A6 50%, #C9D1C3 75%, #135E73 100%) border-box;
    box-shadow: 0 16px 44px rgba(19, 94, 115, 0.20);
    transition: transform 0.3s, box-shadow 0.3s;
  }
  .gh-pkg:hover { transform: translateY(-6px); box-shadow: 0 26px 64px rgba(19, 94, 115, 0.28); }
  .gh-pkg.is-featured {
    /* Featured goes DARKER, not lighter. #17708A would have read as the obvious
       lift but drops the label token to 3.84:1; #0F5164 keeps the worst case at
       6.00:1 while still separating from the plain card. Same gradient ring,
       just re-paired with the darker fill. */
    background:
      linear-gradient(#0F5164, #0F5164) padding-box,
      linear-gradient(135deg, #135E73 0%, #2AAFDF 25%, #1B88A6 50%, #C9D1C3 75%, #135E73 100%) border-box;
    box-shadow: 0 0 0 1px rgba(255,255,255,.18), 0 20px 54px rgba(19, 94, 115, 0.28);
  }
  .gh-pkg.is-featured:hover { box-shadow: 0 0 0 1px rgba(255,255,255,.32), 0 30px 74px rgba(19, 94, 115, 0.34); }
  .gh-pkg__badge {
    position: absolute; top: 20px; right: 20px; z-index: 2;
    font: 500 10px/1 var(--gh-mono); letter-spacing: 0.14em; color: #135E73;
    background: #F7F5F3; padding: 6px 11px; border-radius: 2px;
  }
  /* Icon tile and title share the first row; subtitle and price span the full
     width underneath. Auto-placement, not explicit columns, so a package with
     "No icon" puts its title in track 1 and stays flush left instead of
     inheriting the gutter the missing tile would have left behind. */
  .gh-pkg__head {
    position: relative; padding: 26px 30px 20px;
    display: grid; grid-template-columns: auto 1fr;
    align-items: center; column-gap: 14px;
    border-bottom: 1px solid rgba(255,255,255,.14);
    background: radial-gradient(120% 140% at 100% 0%, rgba(255,255,255,.07), transparent 60%);
  }
  .gh-pkg__subtitle, .gh-pkg__price { grid-column: 1 / -1; }
  .gh-pkg.is-featured .gh-pkg__head { background: radial-gradient(120% 140% at 0% 0%, rgba(255,255,255,.09), transparent 60%); }
  /* Square icon tile: a small logo-like mark for each package. Frosted glass
     rather than a solid fill, so it reads on both the plain and the featured
     card gradient without a second colour. aspect-ratio keeps it square if the
     size is ever changed from one value. */
  .gh-pkg__icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 44px; aspect-ratio: 1; margin: 0;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.10);
    border: 1px solid rgba(255, 255, 255, 0.20);
    color: var(--gh-white);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.16);
    transition: background 0.3s, border-color 0.3s;
  }
  .gh-pkg:hover .gh-pkg__icon { background: rgba(255, 255, 255, 0.17); border-color: rgba(255, 255, 255, 0.32); }
  .gh-pkg__icon svg { display: block; }
  /* The featured card's badge sits top-right, so the tile never collides. */

  /* Package titles stay in Chillax (brand display face); everything else in the
     card is DM Sans. */
  .gh-pkg__name { font: 600 26px/1.1 var(--gh-sans); color: var(--gh-white); margin: 0; padding: 0; letter-spacing: -0.01em; }
  /* Carries the gap under the icon row now that the title has no bottom margin. */
  .gh-pkg__subtitle { font: 400 14px/1.4 var(--gh-mono); color: var(--gh-muted); margin: 11px 0 12px; padding: 0; }
  .gh-pkg__price { font: 500 24px/1 var(--gh-mono); color: var(--gh-price); letter-spacing: 0; }
  .gh-pkg__unit { font-size: 18px; }

  .gh-pkg__body { padding: 20px 30px 24px; flex: 1; display: flex; flex-direction: column; }
  /* Lead line */
  .gh-pkg__intro { font: 400 15px/1.45 var(--gh-mono); color: var(--gh-light); margin: 0 0 18px; }
  /* Each block is a labelled section split by a hairline divider */
  .gh-pkg__section { padding-top: 16px; border-top: 1px solid rgba(255,255,255,.14); margin-bottom: 16px; }
  .gh-pkg__label { font: 500 10px/1 var(--gh-mono); letter-spacing: 0.2em; text-transform: uppercase; color: var(--gh-slate); margin-bottom: 12px; }
  /* Feature rows: bold term on its own line, description under it (no dashes) */
  .gh-pkg__features ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .gh-pkg__features li { font: 400 13px/1.4 var(--gh-mono); color: var(--gh-muted); padding: 9px 0; border-bottom: 1px solid rgba(255,255,255,.12); }
  .gh-pkg__features li:first-child { padding-top: 0; }
  .gh-pkg__features li:last-child { border-bottom: 0; padding-bottom: 0; }
  .gh-pkg__features strong { display: block; font: 600 14px/1.25 var(--gh-mono); color: var(--gh-white); margin-bottom: 1px; }
  .gh-pkg__features p { margin: 0; }
  /* Closing note as a highlighted callout, not loose text */
  .gh-pkg__note {
    background: rgba(255,255,255, 0.09); border: 1px solid rgba(255,255,255, 0.16);
    border-left: 3px solid #A5E4F2; border-radius: 10px;
    padding: 14px 16px; margin-bottom: 16px;
    display: flex; flex-direction: column; gap: 7px;
  }
  .gh-pkg__note p { font: 400 13px/1.45 var(--gh-mono); color: var(--gh-light); margin: 0; }
  /* Add-ons as bordered rows */
  .gh-pkg__addons { margin-bottom: 20px; }
  .gh-pkg__addon-list { display: flex; flex-direction: column; gap: 6px; }
  .gh-pkg__addon {
    font: 400 13px/1.35 var(--gh-mono); color: var(--gh-muted); margin: 0;
    padding: 9px 12px; border-radius: 7px;
    background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.15);
  }
  /* Cream button pops on the teal card */
  .gh-pkg__cta { width: 100%; justify-content: center; margin-top: auto; font: 500 14px/1 var(--gh-mono); letter-spacing: 0.06em; text-transform: uppercase; padding: 15px 24px; }
  .gh-pkg .gh-btn--solid { background: #F7F5F3; color: #135E73; }
  .gh-pkg .gh-btn--solid:hover { background: #FFFFFF; color: #135E73; }

  .gh-glp {
    margin-top: 28px; border-radius: 14px; background: rgba(19,94,115,.06);
    border: 1px solid rgba(19,94,115,.2); padding: 32px 36px;
    display: flex; gap: 22px; align-items: flex-start;
  }
  .gh-glp__glyph { font: 400 30px/1 var(--gh-mono); color: var(--gh-green); flex-shrink: 0; }
  .gh-glp__title { font: 500 20px/1.4 var(--gh-mono); color: var(--gh-white); margin-bottom: 12px; }
  .gh-glp__body, .gh-glp__body p { font: 400 17px/1.6 var(--gh-mono); color: var(--gh-light); max-width: 820px; margin: 0; }
  .gh-glp__body strong { font-weight: 600; color: var(--gh-green); }

  @media (max-width: 768px) {
    .gh-protocols__h2 { font-size: 30px; margin-bottom: 24px; }
    .gh-protocols__cards { grid-template-columns: 1fr; gap: 16px; }
    .gh-pkg:hover { transform: none; }
    .gh-pkg__head { padding: 22px 20px 18px; }
    .gh-pkg__head { column-gap: 12px; }
    .gh-pkg__icon { width: 38px; border-radius: 9px; }
    .gh-pkg__name { font-size: 24px; }
    .gh-pkg__price { font-size: 22px; }
    .gh-pkg__unit { font-size: 16px; }
    .gh-pkg__body { padding: 18px 20px 22px; }
    .gh-glp { padding: 26px; gap: 0; flex-direction: column; }
    .gh-glp__glyph { display: none; }
    .gh-glp__title { font-size: 18px; margin-bottom: 10px; }
    .gh-glp__body, .gh-glp__body p { font-size: 15px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Galim · Protocols",
  "class": "gh-section-full",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor id", "default": "plans" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "03 / PROTOCOLS" },
