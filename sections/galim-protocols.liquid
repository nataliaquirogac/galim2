        { "type": "text", "id": "price_unit", "label": "Price unit", "default": "MXN" },
        { "type": "textarea", "id": "tags", "label": "Summary tags (one per line)", "info": "Short pills shown under the subtitle, visible whether the card is open or closed.", "default": "Body fat & muscle\nStrength\nVO2 max\nStability & mobility\nBody measurements" },
        { "type": "text", "id": "intro", "label": "Intro line (under price)", "default": "Your BQ — where your body ranks, and what to train next." },
        { "type": "text", "id": "features_label", "label": "Features section label", "default": "WHAT WE MEASURE" },
        { "type": "richtext", "id": "features", "label": "Features (list, bold = term on top, rest under it)", "default": "<ul><li><strong>Muscle & fat</strong> kilo by kilo, not an estimate</li><li><strong>Strength</strong> how you rank for your age</li><li><strong>VO₂ max</strong> the strongest single predictor of lifespan</li><li><strong>Stability & mobility</strong> the restriction that will injure you</li><li><strong>Metabolic health</strong> how efficiently you burn fuel</li></ul>" },
        { "type": "richtext", "id": "outro", "label": "Closing lines (first paragraph = bold label)", "default": "<p>YOU LEAVE WITH:</p><p>Your BQ, your level, and the three things to fix. Re-test every 8–12 weeks. Watch the number move.</p>" },
        { "type": "text", "id": "addon_title", "label": "Add-ons title (mono)", "default": "ADD-ONS" },
        { "type": "textarea", "id": "addon_line", "label": "Add-ons (one per line, optional)", "default": "RMR — $700 — your real calorie number\nLactate Threshold — $1,300 — your exact training zones\nGalim AI — your plan, adjusted daily" },
        { "type": "text", "id": "button_label", "label": "Button label (shown as [ … ])", "default": "BOOK YOUR BQ" },
        { "type": "url", "id": "button_link", "label": "Button link", "info": "Leave blank to open the waitlist modal." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Galim · Protocols",
      "blocks": [
        { "type": "package", "settings": { "name": "Performance", "subtitle": "<p><strong>25 min.</strong> Six systems, one number.</p>", "price": "$1,499", "price_unit": "MXN", "tags": "Muscle & fat\nStrength\nVO2 max\nStability & mobility\nMetabolic health", "intro": "Your BQ — where your body ranks, and what to train next.", "features_label": "WHAT WE MEASURE", "features": "<ul><li><strong>Muscle & fat</strong> kilo by kilo, not an estimate</li><li><strong>Strength</strong> how you rank for your age</li><li><strong>VO₂ max</strong> the strongest single predictor of lifespan</li><li><strong>Stability & mobility</strong> the restriction that will injure you</li><li><strong>Metabolic health</strong> how efficiently you burn fuel</li></ul>", "outro": "<p>YOU LEAVE WITH:</p><p>Your BQ, your level, and the three things to fix. Re-test every 8–12 weeks. Watch the number move.</p>", "addon_line": "RMR - your real calorie number $700\nLactate Threshold - your exact training zones $1300\nGalim AI - your plan, adjusted daily", "button_label": "BOOK YOUR BQ" } },
        { "type": "package", "settings": { "name": "Prevention", "subtitle": "<p><strong>50 min.</strong> Every system, your biological age.</p>", "price": "$4,999", "price_unit": "MXN", "tags": "Heart & arteries\nBrain\nOrgans & metabolism\nStructure\nSenses & skin", "intro": "Performance tells you where you stand today. Prevention tells you what's coming.", "features_label": "WHAT WE SCREEN", "features": "<ul><li><strong>Heart & arteries</strong> arterial age, plaque risk. The #1 killer, found early.</li><li><strong>Brain</strong> cognition, retina, vascular risk</li><li><strong>Organs & metabolism</strong> blood, liver, kidney, thyroid, hormones</li><li><strong>Structure</strong> bone density, lung function</li><li><strong>Senses & skin</strong> vision, hearing, skin age</li></ul>", "outro": "<p>YOU LEAVE WITH:</p><p>Your biological age for each system, the gap against your real age, and what to do about the worst one. Once a year. Watch the gap close. Includes everything in Performance and Galim AI.</p>", "addon_line": "RMR - your real calorie number $700\nLactate Threshold - your exact training zones $1300", "button_label": "BOOK YOUR PREVENTION VISIT" } }
