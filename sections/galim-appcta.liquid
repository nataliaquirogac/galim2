{%- comment -%}
  Galim Health — Get the app
  Left: eyebrow + statement + Android/iOS buttons. Right: phone render.
{%- endcomment -%}

{%- liquid
  assign s = section.settings

  # Slide 1 keeps the old fallback chain so an untouched section looks the same.
  assign src = ''
  if s.image != blank
    assign src = s.image | image_url: width: 1400
  elsif s.image_url != blank
    assign src = s.image_url
  else
    assign src = 'app-phone.jpg' | asset_url
  endif

  # Slide 2 has NO fallback: leaving it empty must mean one photo and no carousel
  # chrome, not a duplicate of the default render.
  assign src2 = ''
  if s.image_2 != blank
    assign src2 = s.image_2 | image_url: width: 1400
  elsif s.image_2_url != blank
    assign src2 = s.image_2_url
  endif

  assign alt = s.heading | strip_html | escape | default: shop.name
-%}

<section
  {% if s.anchor_id != blank %}id="{{ s.anchor_id }}"{% endif %}
  class="gh-app gh-section" data-gh-section="appcta">
  <div class="gh-container gh-app__grid">
    <div class="gh-app__text">
      {%- if s.eyebrow != blank -%}<p class="gh-eyebrow gh-app__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="gh-app__h2">{{ s.heading | newline_to_br }}</h2>{%- endif -%}
      {%- if s.body != blank -%}<p class="gh-app__body">{{ s.body }}</p>{%- endif -%}
    </div>
    <div class="gh-app__media">
      {%- if src2 != blank -%}
        <div class="gh-app__carousel" data-gh-app-carousel>
          <div class="gh-app__track" data-gh-app-track>
            <div class="gh-app__slide">
              <img class="gh-app__img" src="{{ src }}" alt="{{ alt }}" loading="lazy" decoding="async">
            </div>
            <div class="gh-app__slide">
              <img class="gh-app__img" src="{{ src2 }}" alt="{{ alt }}" loading="lazy" decoding="async">
            </div>
          </div>
          <div class="gh-app__dots">
            <button type="button" class="gh-app__dot is-active" data-gh-app-dot aria-label="Photo 1" aria-current="true"></button>
            <button type="button" class="gh-app__dot" data-gh-app-dot aria-label="Photo 2" aria-current="false"></button>
          </div>
        </div>
      {%- else -%}
        <img class="gh-app__img" src="{{ src }}" alt="{{ alt }}" loading="lazy" decoding="async">
      {%- endif -%}
    </div>
    <div class="gh-app__btns">
      {%- if s.android_label != blank -%}
        <a href="{{ s.android_link | default: '#' }}" class="gh-btn gh-btn--solid gh-app__btn"{% if s.android_link == blank %} data-gh-waitlist-open{% else %} target="_blank" rel="noopener"{% endif %}>{%- render 'icon-google-play', size: 18 -%}{{ s.android_label }}</a>
      {%- endif -%}
      {%- if s.ios_label != blank -%}
        <a href="{{ s.ios_link | default: '#' }}" class="gh-btn gh-btn--outline gh-app__btn"{% if s.ios_link == blank %} data-gh-waitlist-open{% else %} target="_blank" rel="noopener"{% endif %}>{%- render 'icon-apple', size: 18 -%}{{ s.ios_label }}</a>
      {%- endif -%}
    </div>
  </div>

  {%- if src2 != blank -%}
    {%- comment -%}
      Must stay INSIDE <section>: as a sibling after </section> the script cannot
      resolve its own section and silently wires up nothing (the bug that killed
      the gallery arrows).
    {%- endcomment -%}
    <script>
      (function () {
        var self = document.currentScript;
        var scope = self.parentElement || document;
        var root = scope.querySelector('[data-gh-app-carousel]');
        if (!root) return;
        var track = root.querySelector('[data-gh-app-track]');
        var dots = [].slice.call(root.querySelectorAll('[data-gh-app-dot]'));
        if (!track || dots.length < 2) return;

        function activate(i) {
          for (var n = 0; n < dots.length; n++) {
            var on = n === i;
            dots[n].classList.toggle('is-active', on);
            dots[n].setAttribute('aria-current', on ? 'true' : 'false');
          }
        }

        dots.forEach(function (dot, i) {
          dot.addEventListener('click', function () {
            track.scrollTo({ left: i * track.clientWidth, behavior: 'smooth' });
            /* Paint the dot now: the smooth scroll has not moved scrollLeft yet,
               so waiting for the scroll event leaves the dots a frame behind. */
            activate(i);
          });
        });

        track.addEventListener('scroll', function () {
          var w = track.clientWidth || 1;
          var i = Math.round(track.scrollLeft / w);
          activate(Math.max(0, Math.min(dots.length - 1, i)));
        }, { passive: true });
      })();
    </script>
  {%- endif -%}
</section>

{% stylesheet %}
  /* Desktop: two columns — text + buttons stacked on the left, phone on the
     right (spanning both rows). Named areas (not source order + flex order)
     because the buttons need to move to a different position relative to the
     photo between desktop and mobile, not just reverse. */
  .gh-app__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-areas: "text media" "btns media";
    gap: 56px 56px;
    /* start, not center: media spans both rows, and centering would let its
       own tall content inflate the "btns" row height, leaving the buttons
       floating far below the text instead of right under it. */
    align-items: start;
  }
  .gh-app__media { align-self: center; }
  .gh-app__text { grid-area: text; display: flex; flex-direction: column; align-items: flex-start; text-align: left; }
  .gh-app__eyebrow { margin-bottom: 28px; }
  .gh-app__h2 { font: 300 clamp(30px, 3.6vw, 46px)/1.16 var(--gh-sans); letter-spacing: -0.02em; color: var(--gh-light); margin: 0; }
  .gh-app__body { font: 300 17px/1.6 var(--gh-sans); color: var(--gh-muted); margin: 20px 0 0; max-width: 420px; }
  .gh-app__btns { grid-area: btns; display: flex; gap: 16px; flex-wrap: wrap; margin-top: 40px; }
  .gh-app__btn { min-width: 180px; justify-content: center; }
  .gh-app__media { grid-area: media; display: flex; justify-content: center; }
  .gh-app__img { display: block; width: 100%; max-width: 440px; height: auto; border-radius: 20px; }

  /* Carousel — only rendered when a second photo is set. One photo per view with
     native snap, so swipe works on touch without any JS. */
  .gh-app__carousel { width: 100%; max-width: 440px; }
  .gh-app__track {
    display: flex;
    align-items: center;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .gh-app__track::-webkit-scrollbar { display: none; }
  .gh-app__slide { flex: 0 0 100%; scroll-snap-align: start; }
  /* The cap lives on the wrapper now; the image fills its own slide. */
  .gh-app__carousel .gh-app__img { max-width: none; }

  .gh-app__dots { display: flex; gap: 4px; justify-content: center; margin-top: 14px; }
  .gh-app__dot {
    width: 28px; height: 28px; padding: 0; border: 0; background: none;
    cursor: pointer; display: inline-flex; align-items: center; justify-content: center;
  }
  /* Dot drawn on a pseudo-element so the tap target can be 28px without the
     visible circle growing with it. */
  .gh-app__dot::after {
    content: ''; width: 8px; height: 8px; border-radius: 50%;
    border: 1px solid var(--gh-brand); background: transparent;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .gh-app__dot:hover::after { background: rgba(19, 94, 115, 0.35); }
  .gh-app__dot.is-active::after { background: var(--gh-brand); transform: scale(1.3); }

  /* Mobile: single centered column, buttons BELOW the photo (was above it,
     between the body copy and the photo). */
  @media (max-width: 768px) {
    .gh-app__grid {
      grid-template-columns: 1fr;
      grid-template-areas: "text" "media" "btns";
      gap: 28px; text-align: center;
    }
    .gh-app__text { align-items: center; text-align: center; }
    .gh-app__eyebrow { margin-bottom: 18px; }
    .gh-app__body { margin: 20px auto 0; }
    .gh-app__btns { justify-content: center; margin-top: 0; }
    .gh-app__btn { flex: 1 1 auto; min-width: 0; }
    .gh-app__img { max-width: 300px; }
    .gh-app__carousel { max-width: 300px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Galim · Get the app",
  "class": "gh-section-full",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor id", "default": "app" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "GET THE APP" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Your health. Your data.\nYour next move." },
    { "type": "textarea", "id": "body", "label": "Body (optional)" },
    { "type": "image_picker", "id": "image", "label": "Photo 1", "info": "Defaults to the app render if empty." },
    { "type": "text", "id": "image_url", "label": "…or image 1 URL" },
    { "type": "image_picker", "id": "image_2", "label": "Photo 2 (optional)", "info": "Add a second photo to turn this into a carousel. Leave empty for a single image." },
    { "type": "text", "id": "image_2_url", "label": "…or image 2 URL" },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "android_label", "label": "Android label", "default": "Android" },
    { "type": "url", "id": "android_link", "label": "Android link", "info": "Leave blank to open the waitlist modal." },
    { "type": "text", "id": "ios_label", "label": "iOS label", "default": "iOS" },
    { "type": "url", "id": "ios_link", "label": "iOS link", "info": "Leave blank to open the waitlist modal." }
  ],
  "presets": [{ "name": "Galim · Get the app" }]
}
{% endschema %}
