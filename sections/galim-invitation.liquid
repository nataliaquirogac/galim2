{%- comment -%}
  Galim Health — Private Invitation
  Standalone landing page for gift-card QR codes (physical card, "scan to
  book"). Lives at /invitacion-especial via a URL redirect to this page's
  real Shopify handle. The referrer's name reads from a ?ref= query param
  client-side (Liquid can't see query strings) to personalize "Invitación
  privada de {name}".

  Two-step booking, titular then guest (+1), each saved as its OWN Shopify
  customer tagged "invitacion especial" — native path only (no external
  endpoint set).

  IMPORTANT: this uses a SINGLE {% form 'customer' %} block, not two.
  Shopify's form.posted_successfully? is true for EVERY 'customer'-type
  form rendered on the page once ANY of them succeeds — it's scoped to the
  form TYPE for the request, not to the individual {% form %} tag instance.
  Two separate {% form 'customer' %} blocks on one page were tested live
  and both flipped to "successful" from a single submission (and so did
  the sitewide waitlist modal, elsewhere on the page — see the
  template.suffix guard around its render in layout/theme.liquid).
  So instead: one form, two field-groups sharing the same contact[...]
  names, toggled via `disabled` (which IS reliably exempt from constraint
  validation, unlike a merely-hidden required field). Which group is
  active, and which "done" message shows, is tracked in a ?step= query
  param set via the native `return_to` hidden field on success — Liquid
  can't read query strings, so this routing is entirely client-side (see
  the native-mode block in galim.js). form.errors is still shown inline
  since there's now only one 'customer' form on this page to attribute it
  to.

  If an external form endpoint IS set, there's no native one-customer-per-
  post constraint, so both people post together in one request instead;
  "Next"/"Skip" are client-side field-group toggles there too (see
  [data-gh-invite-next] in galim.js), but it's a genuinely different code
  path from the native one described above.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign action = s.form_action
-%}

<section id="{{ s.anchor_id | default: 'invitacion' }}" class="gh-invite gh-section" data-gh-section="invitation" style="background: {{ s.bg_color | default: '#0D3B46' }};">
  <div class="gh-invite__dots" aria-hidden="true"></div>
  <div class="gh-invite__glow" aria-hidden="true"></div>

  <div class="gh-container gh-invite__inner">
    <div class="gh-invite__intro">
      <p class="gh-eyebrow gh-invite__eyebrow">{{ s.eyebrow | default: 'PRIVATE INVITATION' }}</p>
      <p class="gh-invite__ref" data-gh-invite-ref data-gh-invite-ref-prefix="{{ 'invitation.referred_by_prefix' | t }}" hidden></p>
      <h1 class="gh-invite__h1">{{ s.heading | default: 'Know your body better than ever.' }}</h1>
      {%- if s.subheading != blank -%}<p class="gh-invite__sub">{{ s.subheading }}</p>{%- endif -%}
    </div>

    <div class="gh-invite__offer">
      <span class="gh-invite__offer-badge">{{ s.offer_badge | default: '2 COMPLIMENTARY RMR' }}</span>
      <p class="gh-invite__offer-line">{{ s.offer_line | default: "One Resting Metabolic Rate (RMR) assessment for you, and one for whoever you'd like to bring." }}</p>
      <p class="gh-invite__value">{{ s.value_note | default: 'Value $1,500 MXN per person · Complimentary, no cost' }}</p>
    </div>

    <div class="gh-invite__panel" data-gh-invite-form>

      {%- comment -%} ---------------- STEP 1: titular ---------------- {%- endcomment -%}
      {%- capture step1_fields -%}
        <p class="gh-invite__step-label">{{ s.step1_label | default: 'Step 1 of 2 · Your details' }}</p>
        <label class="gh-field">
          <span class="gh-field__label">{{ 'invitation.first_name' | t }}</span>
          <input type="text" name="{% if action == blank %}contact[first_name]{% else %}name{% endif %}" required autocomplete="given-name">
        </label>
        <div class="gh-field-row">
          <label class="gh-field">
            <span class="gh-field__label">{{ 'invitation.last_name' | t }}</span>
            <input type="text" {% if action == blank %}data-gh-invite-last1{% else %}name="last_name"{% endif %} required autocomplete="family-name">
          </label>
          <label class="gh-field">
            <span class="gh-field__label">{{ 'invitation.last_name_2' | t }}</span>
            <input type="text" {% if action == blank %}data-gh-invite-last2{% else %}name="last_name_2"{% endif %} required autocomplete="additional-name">
          </label>
        </div>
        <div class="gh-field-row">
          <label class="gh-field">
            <span class="gh-field__label">{{ 'invitation.phone' | t }}</span>
            <input type="tel" {% if action == blank %}data-gh-invite-phone{% else %}name="phone"{% endif %} required autocomplete="tel" inputmode="tel" placeholder="81 1234 5678">
          </label>
          <label class="gh-field">
            <span class="gh-field__label">{{ 'invitation.email' | t }}</span>
            <input type="email" name="{% if action == blank %}contact[email]{% else %}email{% endif %}" required autocomplete="email">
          </label>
        </div>
        <button type="submit" class="gh-btn gh-btn--solid gh-invite__submit" data-gh-invite-next>{{ s.button_label | default: "Next: your guest's details" }} →</button>
      {%- endcapture -%}

      {%- comment -%} ---------------- STEP 2: guest (+1) ---------------- {%- endcomment -%}
      {%- capture step2_fields -%}
        <p class="gh-invite__step-label">{{ s.step2_label | default: "Step 2 of 2 · Your guest's details" }}</p>
        <label class="gh-field">
          <span class="gh-field__label">{{ 'invitation.first_name' | t }}</span>
          <input type="text" name="{% if action == blank %}contact[first_name]{% else %}guest[first_name]{% endif %}" disabled autocomplete="given-name">
        </label>
        <div class="gh-field-row">
          <label class="gh-field">
            <span class="gh-field__label">{{ 'invitation.last_name' | t }}</span>
            <input type="text" {% if action == blank %}data-gh-invite-guest-last1{% else %}name="guest[last_name]"{% endif %} disabled autocomplete="family-name">
          </label>
          <label class="gh-field">
            <span class="gh-field__label">{{ 'invitation.last_name_2' | t }}</span>
            <input type="text" {% if action == blank %}data-gh-invite-guest-last2{% else %}name="guest[last_name_2]"{% endif %} disabled autocomplete="additional-name">
          </label>
        </div>
        <div class="gh-field-row">
          <label class="gh-field">
            <span class="gh-field__label">{{ 'invitation.phone' | t }}</span>
            <input type="tel" {% if action == blank %}data-gh-invite-guest-phone{% else %}name="guest[phone]"{% endif %} disabled autocomplete="tel" inputmode="tel" placeholder="81 1234 5678">
          </label>
          <label class="gh-field">
            <span class="gh-field__label">{{ 'invitation.email' | t }}</span>
            <input type="email" name="{% if action == blank %}contact[email]{% else %}guest[email]{% endif %}" disabled autocomplete="email">
          </label>
        </div>
        <button type="submit" class="gh-btn gh-btn--solid gh-invite__submit">{{ s.button_guest_label | default: 'Book both visits' }} →</button>
        <button type="button" class="gh-invite__skip" data-gh-invite-skip>{{ s.skip_label | default: "I don't know who's coming yet — continue without a guest" }}</button>
      {%- endcapture -%}

      {%- if action == blank -%}
        {%- form 'customer', class: 'gh-invite__form', id: 'gh-invite-form' -%}
          <input type="hidden" name="contact[tags]" value="invitacion especial">
          <input type="hidden" name="contact[last_name]" data-gh-invite-lastname>
          <input type="hidden" name="contact[note]" data-gh-invite-note>
          <input type="hidden" name="return_to" value="{{ request.path }}" data-gh-invite-return>
          {%- if form.errors -%}<p class="gh-invite__error">{{ form.errors | default_errors }}</p>{%- endif -%}
          <div data-gh-invite-step="1">{{ step1_fields }}</div>
          <div class="gh-invite__form--guest" data-gh-invite-step="2" hidden>{{ step2_fields }}</div>
        {%- endform -%}
      {%- else -%}
        {%- comment -%}
          External endpoint: no native one-customer-per-post constraint, so
          both people post together in a single request instead; "Next"/
          "Skip" are client-side field-group toggles here too (see
          [data-gh-invite-next] / [data-gh-invite-skip] in galim.js).
        {%- endcomment -%}
        <form action="{{ action }}" method="post" class="gh-invite__form" accept-charset="UTF-8">
          <div data-gh-invite-step="1">{{ step1_fields }}</div>
          <div data-gh-invite-step="2" hidden>
            {{ step2_fields }}
            <input type="hidden" name="guest_skipped" data-gh-invite-guest-skipped value="false">
          </div>
        </form>
      {%- endif -%}

      {%- comment -%} ---------------- Done ---------------- {%- endcomment -%}
      <p class="gh-invite__success" data-gh-invite-done hidden>{{ s.success_message | default: "Done! We have your details — we'll reach out to confirm your visit and your guest's." }}</p>
      <p class="gh-invite__success" data-gh-invite-skipped hidden>{{ s.success_message_solo | default: "Done! We have your details — we'll reach out to confirm your visit." }}</p>
    </div>
  </div>
</section>

{% stylesheet %}
  .gh-invite {
    position: relative;
    overflow: hidden;
    color: #F7F5F3;
    /* Dark island: same light-token overrides as the footer/modal so shared
       classes (.gh-eyebrow, .gh-field, .gh-btn--solid) read correctly here. */
    --gh-light: #F7F5F3; --gh-white: #F7F5F3; --gh-muted: #CDE0E4; --gh-slate: #C3D9DD;
    --gh-green: #C3D9DD; --gh-accent: #C3D9DD; --gh-brand: #C3D9DD;
    --gh-cyan: #7DE3E8;
  }
  .gh-invite__dots {
    position: absolute; inset: 0; pointer-events: none;
    background-image: radial-gradient(rgba(255,255,255,.06) 1.4px, transparent 1.4px);
    background-size: 22px 22px;
  }
  .gh-invite__glow {
    position: absolute; left: 50%; top: -80px; width: 780px; height: 520px;
    transform: translateX(-50%); pointer-events: none;
    background: radial-gradient(ellipse at center, rgba(125, 227, 232, 0.18), rgba(125, 227, 232, 0) 70%);
    filter: blur(30px);
  }
  .gh-invite__inner {
    position: relative; z-index: 1;
    max-width: 620px;
    display: flex; flex-direction: column; align-items: center;
    text-align: center;
  }
  .gh-invite__intro { display: flex; flex-direction: column; align-items: center; }
  .gh-invite__eyebrow { color: var(--gh-cyan); letter-spacing: 0.3em; }
  .gh-invite__ref { margin: 14px 0 0; font: 400 15px/1.4 var(--gh-sans); color: var(--gh-muted); }
  .gh-invite__ref[hidden] { display: none; }
  .gh-invite__h1 { margin: 18px 0 0; font: 200 44px/1.1 var(--gh-sans); letter-spacing: -0.02em; color: #F7F5F3; }
  .gh-invite__sub { margin: 16px 0 0; max-width: 440px; font: 300 16px/1.55 var(--gh-sans); color: var(--gh-muted); }

  /* Gradient-ring border, same recipe as the package cards / What-we-measure
     cards / gh-btn--solid: 3px transparent border, fill clipped to
     padding-box, the brand ramp clipped to border-box behind it. 135deg so
     the ramp sweeps every edge (a 90deg gradient leaves flat, invisible
     vertical edges), looping back to its start color so it reads solid on
     every side regardless of the card's aspect ratio. */
  .gh-invite__offer {
    position: relative; margin-top: 44px; width: 100%; box-sizing: border-box;
    border: 3px solid transparent; border-radius: 20px;
    background:
      linear-gradient(rgba(255,255,255,.06), rgba(255,255,255,.06)) padding-box,
      linear-gradient(135deg, #135E73 0%, #2AAFDF 25%, #1B88A6 50%, #C9D1C3 75%, #135E73 100%) border-box;
    backdrop-filter: blur(10px) saturate(1.1);
    -webkit-backdrop-filter: blur(10px) saturate(1.1);
    padding: 30px 32px;
  }
  .gh-invite__offer-badge {
    display: inline-block; font: 500 11px/1 var(--gh-mono); letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--gh-cyan);
    background: rgba(125, 227, 232, 0.12); border: 1px solid rgba(125, 227, 232, 0.3);
    border-radius: 999px; padding: 8px 16px;
  }
  .gh-invite__offer-line { margin: 16px 0 0; font: 400 16px/1.55 var(--gh-sans); color: #F7F5F3; }
  .gh-invite__value { margin: 12px 0 0; font: 500 12px/1 var(--gh-mono); letter-spacing: 0.06em; color: var(--gh-muted); }

  .gh-invite__panel {
    margin-top: 40px; width: 100%; box-sizing: border-box;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.14);
    border-radius: 20px;
    padding: 36px 34px;
    text-align: left;
    box-shadow: 0 30px 80px rgba(0,0,0,0.35);
  }
  .gh-invite__form { display: flex; flex-direction: column; gap: 20px; }
  /* display:flex above beats the hidden attribute's UA display:none (same
     fix already needed for .gh-field and .gh-modal). */
  .gh-invite__form[hidden] { display: none; }
  .gh-invite__form--guest { margin-top: 28px; padding-top: 28px; border-top: 1px solid rgba(255,255,255,0.14); }
  /* The 20px gap above only spaces .gh-invite__form's DIRECT children
     ([data-gh-invite-step="1|2"]) apart from each other — everything
     inside one step (label, fields, rows, button) was stacking with no
     gap of its own, hence "amontonado". This gives every step's own
     content the same rhythm. */
  [data-gh-invite-step] { display: flex; flex-direction: column; gap: 20px; }
  /* Wider than the shared 12px default (galim-waitlist-modal.liquid): this
     page's fields sit on a plainer dark panel with no card boundary of
     their own, so the paired columns need more air to read as separate. */
  .gh-invite .gh-field-row { gap: 16px; }
  /* Slightly wider than the shared 7px default, snapped to the 4px scale. */
  .gh-invite .gh-field { gap: 8px; }
  .gh-invite__step-label {
    margin: 0; font: 500 11px/1 var(--gh-mono); letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--gh-cyan);
  }
  .gh-invite__submit { width: 100%; justify-content: center; margin-top: 4px; }
  .gh-invite__skip {
    display: block; width: 100%; text-align: center; margin-top: 4px;
    background: none; border: 0; cursor: pointer;
    font: 400 13px/1.4 var(--gh-sans); color: var(--gh-muted); text-decoration: underline;
  }
  .gh-invite__skip:hover { color: var(--gh-light); }
  .gh-invite__success { font: 400 17px/1.5 var(--gh-sans); color: var(--gh-green); }
  .gh-invite__success[hidden] { display: none; }
  .gh-invite__error { font: 400 14px/1.5 var(--gh-sans); color: #e8a0a0; margin-bottom: 16px; }
  [data-gh-invite-step][hidden] { display: none; }

  @media (max-width: 768px) {
    .gh-invite__h1 { font-size: 30px; }
    .gh-invite__sub { font-size: 14.5px; }
    .gh-invite__offer { padding: 22px 20px; margin-top: 32px; }
    .gh-invite__offer-line { font-size: 14.5px; }
    .gh-invite__panel { padding: 26px 22px; margin-top: 28px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Galim · Invitation",
  "class": "gh-section-full",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor id", "default": "invitacion" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#0D3B46" },
    { "type": "header", "content": "Copy" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "PRIVATE INVITATION" },
    { "type": "text", "id": "heading", "label": "Headline", "default": "Know your body better than ever." },
    { "type": "textarea", "id": "subheading", "label": "Subheadline", "default": "You've been invited to experience Galim before anyone else." },
    { "type": "header", "content": "Offer" },
    { "type": "text", "id": "offer_badge", "label": "Offer badge", "default": "2 COMPLIMENTARY RMR" },
    { "type": "textarea", "id": "offer_line", "label": "Offer description", "default": "One Resting Metabolic Rate (RMR) assessment for you, and one for whoever you'd like to bring." },
    { "type": "text", "id": "value_note", "label": "Value note", "default": "Value $1,500 MXN per person · Complimentary, no cost" },
    { "type": "header", "content": "Form — step 1 (titular)" },
    { "type": "text", "id": "step1_label", "label": "Step 1 label", "default": "Step 1 of 2 · Your details" },
    { "type": "text", "id": "button_label", "label": "Step 1 button label", "default": "Next: your guest's details" },
    { "type": "header", "content": "Form — step 2 (guest)" },
    { "type": "text", "id": "step2_label", "label": "Step 2 label", "default": "Step 2 of 2 · Your guest's details" },
    { "type": "text", "id": "button_guest_label", "label": "Step 2 button label", "default": "Book both visits" },
    { "type": "text", "id": "skip_label", "label": "Skip-guest link label", "default": "I don't know who's coming yet — continue without a guest" },
    { "type": "header", "content": "Success messages" },
    { "type": "textarea", "id": "success_message", "label": "Success — both booked", "default": "Done! We have your details — we'll reach out to confirm your visit and your guest's." },
    { "type": "textarea", "id": "success_message_solo", "label": "Success — guest skipped", "default": "Done! We have your details — we'll reach out to confirm your visit." },
    {
      "type": "paragraph",
      "content": "Leave the endpoint below blank to use Shopify's native customer form: titular and guest are each saved as their OWN customer, tagged 'invitacion especial'. If an external endpoint is set instead, both post together in one request (no native one-customer-per-post constraint), and Next/Skip are just client-side."
    },
    { "type": "url", "id": "form_action", "label": "External form endpoint (optional)" }
  ],
  "presets": [{ "name": "Galim · Invitation" }]
}
{% endschema %}
