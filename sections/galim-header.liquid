{%- comment -%}
  Galim Health — Sticky header
  White logo · nav (linklist) · Log in · Join Waitlist button.
  Mobile: logo + hamburger opening a drawer with the same links.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign login_url = s.login_url
  if login_url == blank
    assign login_url = routes.account_login_url
  endif
-%}

<header class="gh-header" data-gh-header>
  <div class="gh-header__inner">
    <a href="{{ routes.root_url }}" class="gh-header__logo" aria-label="{{ shop.name }}">
      {%- comment -%} Light theme: pick the teal/black logo in the customizer (the white one is invisible on white). {%- endcomment -%}
      {%- if s.logo != blank -%}
        <img src="{{ s.logo | image_url: width: 400 }}" alt="{{ shop.name }}" width="{{ s.logo.width }}" height="{{ s.logo.height }}" style="height: {{ s.logo_height }}px;" loading="eager">
      {%- else -%}
        <img src="{{ 'logo_galimhealth.png' | asset_url }}" alt="{{ shop.name }}" style="height: {{ s.logo_height }}px;" loading="eager">
      {%- endif -%}
    </a>

    <nav class="gh-header__nav" aria-label="Primary">
      {%- for link in s.menu.links -%}
        {%- capture anchor -%}{%- render 'galim-anchor', title: link.title -%}{%- endcapture -%}
        {%- if s.single_page and anchor != blank -%}
          <a href="{{ anchor }}">{{ link.title }}</a>
        {%- elsif s.single_page -%}
          <span class="gh-header__nav-plain">{{ link.title }}</span>
        {%- else -%}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {%- endif -%}
      {%- endfor -%}
    </nav>

    <div class="gh-header__actions">
      {%- if s.show_login -%}
        <a href="{{ login_url }}" class="gh-header__login">{{ s.login_label | default: 'LOG IN' }}</a>
      {%- endif -%}
      {%- comment -%} Language switch sits before the CTA so the solid pill anchors the right edge. {%- endcomment -%}
      {%- if localization.available_languages.size > 1 -%}
        {%- form 'localization', class: 'gh-header__lang' -%}
          <input type="hidden" name="return_to" value="{{ request.path }}">
          {%- for lang in localization.available_languages -%}
            {%- if lang.iso_code == localization.language.iso_code -%}
              <span class="gh-header__lang-current" aria-current="true">{{ lang.iso_code | upcase }}</span>
            {%- else -%}
              <button type="submit" name="locale_code" value="{{ lang.iso_code }}" class="gh-header__lang-btn" lang="{{ lang.iso_code }}">{{ lang.iso_code | upcase }}</button>
            {%- endif -%}
            {%- unless forloop.last -%}<span class="gh-header__lang-sep">/</span>{%- endunless -%}
          {%- endfor -%}
        {%- endform -%}
      {%- endif -%}
      <a href="#" class="gh-header__cta" data-gh-waitlist-open>{{ s.waitlist_label | default: 'JOIN WAITLIST' }}</a>
    </div>

    <button type="button" class="gh-header__burger" data-gh-drawer-toggle aria-label="Menu" aria-expanded="false" aria-controls="gh-drawer">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

{%- comment -%} Mobile drawer {%- endcomment -%}
<div id="gh-drawer" class="gh-drawer" hidden>
  <div class="gh-drawer__overlay" data-gh-drawer-close></div>
  <aside class="gh-drawer__panel" aria-label="Menu">
    <button type="button" class="gh-drawer__close" data-gh-drawer-close aria-label="Close">&times;</button>
    <nav class="gh-drawer__nav">
      {%- for link in s.menu.links -%}
        {%- capture anchor -%}{%- render 'galim-anchor', title: link.title -%}{%- endcapture -%}
        {%- if s.single_page and anchor != blank -%}
          <a href="{{ anchor }}" data-gh-drawer-close>{{ link.title }}</a>
        {%- elsif s.single_page == false -%}
          <a href="{{ link.url }}" data-gh-drawer-close>{{ link.title }}</a>
        {%- endif -%}
      {%- endfor -%}
    </nav>
    <div class="gh-drawer__actions">
      {%- if s.show_login -%}
        <a href="{{ login_url }}" class="gh-drawer__login">{{ s.login_label | default: 'LOG IN' }}</a>
      {%- endif -%}
      <a href="#" class="gh-btn gh-btn--solid gh-drawer__cta" data-gh-waitlist-open>{{ s.waitlist_label | default: 'JOIN WAITLIST' }}</a>
    </div>
  </aside>
</div>

<script src="{{ 'galim.js' | asset_url }}" defer="defer"></script>

{% stylesheet %}
  /* Floating pill header. The section wrapper is FIXED, so it takes no layout
     space and the hero starts at the very top of the page with the pill riding
     over it. The announcement bar stays in normal flow above; galim.js parks the
     pill just under it and lets it ride up to the edge as that bar scrolls away. */
  .gh-header-section {
    position: fixed;
    top: var(--gh-hdr-top, 40px);
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    justify-content: center;
    padding: 0 24px;
    /* The transparent gutters either side of the pill must not swallow clicks
       meant for the hero underneath. */
    pointer-events: none;
  }
  .gh-header {
    pointer-events: auto;
    width: min(1040px, 100%);
    border-radius: 999px;
    background: rgba(247, 245, 243, 0.78);
    -webkit-backdrop-filter: blur(18px) saturate(1.35);
    backdrop-filter: blur(18px) saturate(1.35);
    border: 1px solid rgba(255, 255, 255, 0.65);
    box-shadow: 0 10px 34px rgba(13, 59, 70, 0.18), inset 0 1px 0 rgba(255, 255, 255, 0.7);
    /* #6E8897 tertiary text only reaches 2.9:1 on the glass — darken it here. */
    --gh-slate: #4C6670;
    transition: background 0.25s ease, box-shadow 0.25s ease;
  }
  /* Once page copy (rather than the hero) is passing underneath, the glass goes
     nearly opaque so text doesn't ghost through the pill. */
  .gh-header.is-condensed {
    background: rgba(247, 245, 243, 0.93);
    box-shadow: 0 8px 24px rgba(13, 59, 70, 0.16), inset 0 1px 0 rgba(255, 255, 255, 0.7);
  }
  .gh-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 10px 12px 10px 24px;
    transition: padding 0.25s ease;
  }
  .gh-header.is-condensed .gh-header__inner { padding-top: 8px; padding-bottom: 8px; }
  .gh-header__logo { display: inline-flex; align-items: center; flex: 0 0 auto; }
  .gh-header__logo img { width: auto; display: block; }

  /* Only the landing page puts a hero behind the pill. Everywhere else the fixed
     header would cover the top of the content, so reserve room for it. */
  body:not(.gh-page) #MainContent { padding-top: 84px; }

  /* Single-page menu items are anchors; without this the target section lands
     underneath the floating pill. */
  html { scroll-padding-top: 96px; }

  .gh-header__nav {
    display: flex;
    gap: 38px;
    font: 400 14px/1 var(--gh-sans);
    letter-spacing: 0.02em;
  }
  .gh-header__nav a { color: var(--gh-light); }
  .gh-header__nav a:hover { color: var(--gh-green); }
  .gh-header__nav-plain { color: var(--gh-muted); cursor: default; }

  .gh-header__actions { display: flex; gap: 22px; align-items: center; }
  .gh-header__login {
    font: 400 13px/1 var(--gh-mono);
    letter-spacing: 0.05em;
    color: var(--gh-light);
    opacity: 0.8;
  }
  .gh-header__login:hover { opacity: 1; color: var(--gh-green); }
  .gh-header__cta {
    border: 1px solid #135E73;
    background: #135E73;
    color: #F7F5F3;
    padding: 11px 20px;
    border-radius: 999px;
    font: 500 11px/1 var(--gh-mono);
    letter-spacing: 0.12em;
    white-space: nowrap;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .gh-header__cta:hover { background: #16505F; border-color: #16505F; color: #F7F5F3; transform: translateY(-1px); }

  .gh-header__lang {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font: 500 12px/1 var(--gh-mono);
    letter-spacing: 0.08em;
  }
  .gh-header__lang-current { color: var(--gh-white); }
  .gh-header__lang-sep { color: var(--gh-slate); }
  .gh-header__lang-btn {
    background: none;
    border: 0;
    padding: 2px;
    color: var(--gh-slate);
    font: inherit;
    letter-spacing: inherit;
    cursor: pointer;
  }
  .gh-header__lang-btn:hover { color: var(--gh-green); }

  .gh-header__burger {
    display: none;
    flex-direction: column;
    gap: 4px;
    width: 22px;
    background: none;
    border: 0;
    cursor: pointer;
    padding: 4px 0;
  }
  .gh-header__burger span { height: 1.5px; background: var(--gh-light); border-radius: 2px; }
  .gh-header__burger span:last-child { width: 14px; }

  /* Drawer — the fixed pill wrapper is pointer-events: none, so re-enable here. */
  .gh-drawer { position: fixed; inset: 0; z-index: 150; pointer-events: auto; }
  .gh-drawer__overlay { position: absolute; inset: 0; background: rgba(6, 31, 38, 0.6); }
  .gh-drawer__panel {
    position: absolute;
    top: 0;
    right: 0;
    height: 100%;
    width: min(320px, 84vw);
    background: var(--gh-bg-900);
    border-left: 1px solid var(--gh-border);
    padding: 72px 28px 28px;
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.28s ease;
  }
  .gh-drawer.is-open .gh-drawer__panel { transform: translateX(0); }
  .gh-drawer__close { position: absolute; top: 18px; right: 20px; background: none; border: 0; color: var(--gh-light); font-size: 30px; line-height: 1; cursor: pointer; }
  .gh-drawer__nav { display: flex; flex-direction: column; gap: 22px; }
  .gh-drawer__nav a { font: 300 24px/1 var(--gh-sans); color: var(--gh-light); }
  .gh-drawer__nav a:hover { color: var(--gh-green); }
  .gh-drawer__actions { margin-top: auto; display: flex; flex-direction: column; gap: 16px; padding-top: 32px; }
  .gh-drawer__login { font: 400 13px/1 var(--gh-mono); letter-spacing: 0.08em; color: var(--gh-muted); }
  .gh-drawer__cta { justify-content: center; }

  /* The pill is capped at 1040px, so with a menu assigned the links only fit from
     ~1000px up — measured 148px of overflow at 769px, 17px at 900px. Below that the
     nav hides rather than spilling past the rounded edge (which doesn't clip). */
  @media (max-width: 999px) {
    .gh-header__nav { display: none; }
  }
  @media (min-width: 1000px) and (max-width: 1120px) {
    .gh-header__nav { gap: 26px; }
  }

  @media (max-width: 768px) {
    .gh-header-section { top: var(--gh-hdr-top, 34px); padding: 0 12px; }
    .gh-header__inner { padding: 8px 8px 8px 14px; gap: 12px; }
    .gh-header.is-condensed .gh-header__inner { padding-top: 7px; padding-bottom: 7px; }
    body:not(.gh-page) #MainContent { padding-top: 72px; }
    html { scroll-padding-top: 80px; }
    .gh-header__login,
    .gh-header__burger { display: none; }
    .gh-header__cta { padding: 8px 13px; font-size: 10px; }
    /* With more than one published language, mobile swaps the CTA for ES/EN */
    .gh-header__lang {
      /* Pale hairline vanished on the cream glass — use a teal one, pill-shaped. */
      border: 1px solid rgba(19, 94, 115, 0.22);
      border-radius: 999px;
      padding: 7px 12px;
    }
    .gh-header__actions:has(.gh-header__lang) .gh-header__cta { display: none; }
    .gh-header__lang-btn { padding: 0; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Galim · Header",
  "class": "gh-header-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo (white, for dark header)",
      "info": "Defaults to logo_galimhealth_white.png in assets."
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 16,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Logo height (desktop)",
      "default": 26
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "single_page",
      "label": "Single-page navigation",
      "info": "Menu items link to landing sections (Home, Catalog, Method, Contact become anchors). Unmatched items show as plain text.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_login",
      "label": "Show Log in link",
      "default": true
    },
    {
      "type": "text",
      "id": "login_label",
      "label": "Log in label",
      "default": "LOG IN"
    },
    {
      "type": "url",
      "id": "login_url",
      "label": "Log in URL",
      "info": "Leave blank to use the customer login page."
    },
    {
      "type": "text",
      "id": "waitlist_label",
      "label": "Waitlist button label",
      "default": "JOIN WAITLIST"
    }
  ]
}
{% endschema %}
