{%- comment -%}
  Galim Health — 04 / ADVANCED DIAGNOSTICS
  Five full-width rows (repeatable blocks): icon · faded number · name+desc · arrow.
{%- endcomment -%}

{%- liquid assign s = section.settings -%}

<section class="gh-diag gh-section" data-gh-section="diagnostics" style="background: {{ s.bg_color }};">
  <div class="gh-container">
    {%- if s.eyebrow != blank -%}<p class="gh-eyebrow gh-diag__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
    {%- if s.heading != blank -%}<h2 class="gh-diag__h2">{{ s.heading }}</h2>{%- endif -%}
    {%- if s.subheading != blank -%}<p class="gh-diag__sub">{{ s.subheading }}</p>{%- endif -%}

    <div class="gh-diag__rows">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        {%- assign n = forloop.index -%}
        {%- assign row_tag = 'div' -%}
        {%- if b.link != blank -%}{%- assign row_tag = 'a' -%}{%- endif -%}
        <{{ row_tag }} class="gh-diag__row{% if b.featured %} gh-diag__row--featured{% endif %}"{% if b.link != blank %} href="{{ b.link }}"{% endif %} {{ block.shopify_attributes }}>
          <span class="gh-diag__num">{{ n | prepend: '0' | slice: -2, 2 }}</span>
          <span class="gh-diag__text">
            {%- if b.name != blank -%}<span class="gh-diag__name">{{ b.name }}</span>{%- endif -%}
            {%- if b.description != blank -%}<span class="gh-diag__desc">{{ b.description }}</span>{%- endif -%}
          </span>
          <span class="gh-diag__plus" aria-hidden="true">+</span>
        </{{ row_tag }}>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .gh-diag__eyebrow { margin-bottom: 12px; text-align: center; }
  .gh-diag__h2 { font: 200 40px/1.15 var(--gh-sans); letter-spacing: -0.02em; color: var(--gh-white); max-width: 820px; margin: 0 auto 10px; text-align: center; }
  .gh-diag__sub { font: 300 16px/1.5 var(--gh-sans); color: var(--gh-muted); margin: 0 auto 32px; text-align: center; }
  .gh-diag__rows { display: flex; flex-direction: column; gap: 16px; }
  .gh-diag__row {
    display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 24px;
    /* Fully transparent — the page's own light background shows through;
       only the featured row gets a visible surface (its blue ring below). */
    border-radius: 14px; padding: 24px 32px;
    border: 2px solid transparent;
    background: transparent;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    color: var(--gh-light); text-decoration: none;
  }
  .gh-diag__row:hover { transform: translateX(8px); color: var(--gh-light); }
  /* Blue highlight ring on the flagship add-on, per her reference screenshot. */
  .gh-diag__row--featured { border-color: #3B82F6; box-shadow: 0 12px 32px rgba(59, 130, 246, 0.18); }
  .gh-diag__num { font: 300 40px/1 var(--gh-mono); color: var(--gh-brand); }
  .gh-diag__text { display: flex; flex-direction: column; gap: 6px; }
  .gh-diag__name { font: 400 24px/1.15 var(--gh-mono); color: var(--gh-brand); }
  .gh-diag__desc { font: 400 16px/1.4 var(--gh-mono); color: var(--gh-muted); }
  .gh-diag__plus { font: 300 28px/1 var(--gh-mono); color: var(--gh-brand); }

  @media (max-width: 768px) {
    .gh-diag__h2 { font-size: 28px; margin-bottom: 10px; }
    .gh-diag__sub { font-size: 14px; margin-bottom: 24px; }
    .gh-diag__rows { gap: 12px; }
    .gh-diag__row { grid-template-columns: auto 1fr auto; gap: 16px; padding: 20px; }
    .gh-diag__row:hover { transform: none; }
    .gh-diag__num { font-size: 28px; }
    .gh-diag__name { font-size: 18px; }
    .gh-diag__desc { font-size: 13px; }
    .gh-diag__plus { font-size: 22px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Galim · Diagnostics",
  "class": "gh-section-full",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "04 / ADVANCED DIAGNOSTICS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "For those who want to optimize even further." },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Optional · available separately · tailored to your age, family history, goals, and Galim results." },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#0D3B46" }
  ],
  "blocks": [
    {
      "type": "addon",
      "name": "Add-on row",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Whole Genome Sequencing" },
        { "type": "text", "id": "description", "label": "Description", "default": "Your lifelong genetic blueprint" },
        { "type": "checkbox", "id": "featured", "label": "Highlight with blue border", "default": false },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Galim · Diagnostics",
      "blocks": [
        { "type": "addon", "settings": { "name": "Whole Genome Sequencing", "description": "Your lifelong genetic blueprint", "featured": true } },
        { "type": "addon", "settings": { "name": "Full-Body MRI", "description": "Comprehensive whole-body screening" } },
        { "type": "addon", "settings": { "name": "Multi-Cancer Blood Test", "description": "Early screening for 50+ cancers" } },
        { "type": "addon", "settings": { "name": "Coronary CT Angiography", "description": "Detect hidden heart disease" } },
        { "type": "addon", "settings": { "name": "Microbiome Analysis", "description": "Gut health & metabolic insights" } }
      ]
    }
  ]
}
{% endschema %}
