{%- comment -%}
  Galim Health — Statement (white breather)
  A light, opaque section with centered teal text. Placed between the dark
  sections so scrolling alternates light/dark (Neko-style rhythm). Because it is
  opaque it covers the page's fixed gradient, creating the "breather".
{%- endcomment -%}

{%- liquid assign s = section.settings -%}

<section
  {% if s.anchor_id != blank %}id="{{ s.anchor_id }}"{% endif %}
  class="gh-statement gh-section"
  data-gh-section="statement"
  style="--gh-st-bg: {{ s.bg_color | default: '#F7F5F3' }}; --gh-st-teal: {{ s.text_color | default: '#135E73' }}; --gh-st-body: {{ s.body_color | default: '#1C4E5A' }};">
  <div class="gh-statement__inner">
    {%- if s.eyebrow != blank -%}<p class="gh-statement__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
    {%- if s.heading != blank -%}<h2 class="gh-statement__h2">{{ s.heading | newline_to_br }}</h2>{%- endif -%}
    {%- if s.body != blank -%}<p class="gh-statement__body">{{ s.body | newline_to_br }}</p>{%- endif -%}
    {%- if s.button_label != blank -%}
      {%- if s.button_opens_modal -%}
        <a href="#" class="gh-statement__btn" data-gh-waitlist-open>{{ s.button_label }}</a>
      {%- else -%}
        <a href="{{ s.button_link | default: '#' }}" class="gh-statement__btn">{{ s.button_label }}</a>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .gh-statement {
    position: relative; z-index: 1;
    background: var(--gh-st-bg, #F7F5F3);
    padding: 120px 40px; text-align: center;
  }
  .gh-statement__inner { max-width: 860px; margin: 0 auto; }
  .gh-statement__eyebrow {
    font: 500 12px/1.4 var(--gh-mono);
    letter-spacing: 0.28em; text-transform: uppercase;
    color: var(--gh-st-teal, #135E73); margin: 0 0 24px;
  }
  .gh-statement__h2 {
    font: 300 clamp(28px, 4vw, 46px)/1.18 var(--gh-sans);
    letter-spacing: -0.01em; color: var(--gh-st-teal, #135E73); margin: 0;
  }
  .gh-statement__h2 strong { font-weight: 500; }
  .gh-statement__body {
    font: 300 clamp(16px, 2vw, 19px)/1.6 var(--gh-sans);
    color: var(--gh-st-body, #1C4E5A); margin: 24px auto 0; max-width: 680px;
  }
  .gh-statement__btn {
    display: inline-block; margin-top: 36px;
    background: var(--gh-st-teal, #135E73); color: #F7F5F3;
    font: 500 15px/1 var(--gh-sans); letter-spacing: 0.02em;
    padding: 17px 40px; border-radius: 999px;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }
  .gh-statement__btn:hover { transform: translateY(-1px); opacity: 0.92; color: #F7F5F3; }

  @media (max-width: 768px) {
    .gh-statement { padding: 64px 20px; }
    .gh-statement__eyebrow { margin-bottom: 18px; letter-spacing: 0.22em; font-size: 11px; }
    .gh-statement__body { margin-top: 18px; }
    .gh-statement__btn { margin-top: 28px; padding: 15px 34px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Galim · Statement",
  "class": "gh-section-full",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor id" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (teal, uppercase)", "default": "UNA NUEVA FORMA DE CONOCER TU CUERPO" },
    { "type": "textarea", "id": "heading", "label": "Heading (bold with <strong>)", "default": "Medimos tu cuerpo, te mostramos resultados en tiempo real y te damos un plan concreto para mejorar." },
    { "type": "textarea", "id": "body", "label": "Body (optional)" },
    { "type": "text", "id": "button_label", "label": "Button label (optional)" },
    { "type": "checkbox", "id": "button_opens_modal", "label": "Button opens waitlist modal", "default": true },
    { "type": "url", "id": "button_link", "label": "Button link (if not modal)" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#F7F5F3" },
    { "type": "color", "id": "text_color", "label": "Heading / eyebrow (teal)", "default": "#135E73" },
    { "type": "color", "id": "body_color", "label": "Body text", "default": "#1C4E5A" }
  ],
  "presets": [{ "name": "Galim · Statement" }]
}
{% endschema %}
