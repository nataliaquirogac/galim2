{%- comment -%}
  Galim Health — Biometric contour field (ambient page background)
  ---------------------------------------------------------------
  Reusable background component. Renders as a FIXED layer with z-index:-1 as a
  direct child of <body>, so it paints above the root background color but
  BELOW every in-flow section — no stacking-context risk, no effect on layout.
  (Same proven pattern used elsewhere in this theme; a negative-z-index child of
  body sits above the propagated body background but under normal content.)

  Composition:
  - Static teal/aqua radial washes  -> CSS (cheap, crisp, no repaint cost)
  - Animated contour lines/particles -> <canvas> (only the moving parts)

  The field covers the full page (no centre cut-out) so the gradient reads
  edge to edge; line opacity stays low enough for copy to sit on top.

  Accessibility / performance:
  - prefers-reduced-motion  -> renders ONE static frame, no rAF loop
  - touch devices           -> no cursor parallax/glow (pointer:coarse)
  - mobile                  -> fewer particles, coarser line sampling
  - pauses when the tab is hidden; DPR capped at 2
{%- endcomment -%}

<div class="gh-bgfield" aria-hidden="true" data-gh-bgfield>
  <div class="gh-bgfield__wash"></div>
  <div class="gh-bgfield__grid"></div>
  <canvas class="gh-bgfield__canvas" data-gh-bgfield-canvas></canvas>
</div>

{% style %}
  .gh-bgfield {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }

  /* Teal → blue washes over the light page, full-bleed across the viewport. */
  .gh-bgfield__wash {
    position: absolute;
    inset: -10%;
    background:
      /* deep teal corner fade (top-left) */
      radial-gradient(52% 58% at 6% 10%, rgba(19, 94, 115, 0.20), rgba(19, 94, 115, 0) 72%),
      /* aqua / blue sweep (top-right) */
      radial-gradient(56% 62% at 96% 18%, rgba(27, 182, 201, 0.20), rgba(27, 182, 201, 0) 74%),
      /* soft cyan glow (bottom-right) */
      radial-gradient(54% 56% at 88% 92%, rgba(125, 227, 232, 0.24), rgba(125, 227, 232, 0) 72%),
      /* teal anchor (bottom-left) */
      radial-gradient(50% 54% at 4% 88%, rgba(19, 94, 115, 0.17), rgba(19, 94, 115, 0) 74%),
      /* broad diagonal blue gradient tying it all together */
      linear-gradient(135deg, rgba(19, 94, 115, 0.09) 0%, rgba(27, 182, 201, 0.055) 45%, rgba(125, 227, 232, 0.08) 100%);
  }

  /* Fine technical grid — reads as instrumentation / scan readout. Sits between
     the wash and the contour lines. */
  .gh-bgfield__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(19, 94, 115, 0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgba(19, 94, 115, 0.055) 1px, transparent 1px);
    background-size: 72px 72px;
  }

  .gh-bgfield__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  @media (max-width: 768px) {
    .gh-bgfield__grid { background-size: 54px 54px; }
  }
{% endstyle %}

<script>
  (function () {
    'use strict';

    var root = document.querySelector('[data-gh-bgfield]');
    var canvas = root && root.querySelector('[data-gh-bgfield-canvas]');
    if (!canvas || !canvas.getContext) return;

    var ctx = canvas.getContext('2d');
    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var coarse = window.matchMedia('(pointer: coarse)').matches;

    /* Brand palette (visual direction) */
    var TEAL = [19, 94, 115];    /* #135E73 deep medical teal */
    var AQUA = [27, 182, 201];   /* #1BB6C9 aqua accent       */
    var CYAN = [125, 227, 232];  /* #7DE3E8 soft cyan glow    */

    var w = 0, h = 0, dpr = 1, mobile = false;
    var lines = 0, step = 0, particles = [];

    /* Pointer state — lerped toward the target for buttery parallax */
    var pTargetX = 0.5, pTargetY = 0.5;   /* normalised 0..1 */
    var pX = 0.5, pY = 0.5;
    var hasPointer = false;

    var MAX_PARALLAX = 6;   /* px — spec: 4–8px */
    var BREATH = 15;        /* seconds — spec: 12–18s */

    function rgba(c, a) {
      return 'rgba(' + c[0] + ',' + c[1] + ',' + c[2] + ',' + a + ')';
    }

    function resize() {
      var rect = root.getBoundingClientRect();
      w = Math.max(1, Math.round(rect.width));
      h = Math.max(1, Math.round(rect.height));
      mobile = w < 768;
      dpr = Math.min(window.devicePixelRatio || 1, 2);

      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      /* Open contour lines spanning the full width. Mobile keeps a healthy
         count (they read as strata, not as a few stray curves) but samples
         more coarsely to stay cheap. */
      lines = mobile ? 30 : 44;
      step = mobile ? 12 : 9;

      var count = mobile ? 6 : 14;
      particles = [];
      for (var i = 0; i < count; i++) {
        particles.push({
          x: Math.random() * w,
          y: Math.random() * h,
          r: 0.8 + Math.random() * 1.5,
          vx: (-0.5 + Math.random()) * 0.05,
          vy: -0.04 - Math.random() * 0.05,
          a: 0.12 + Math.random() * 0.16,
          ph: Math.random() * Math.PI * 2
        });
      }
    }

    /* One open contour line spanning the full width. Neighbouring lines share
       most of their phase (the `t` term is scaled small), so they bend together
       into coherent flowing strata — a topographic map, not isolated ripples,
       and deliberately never closed circles. */
    function drawFlow(i, time, breathe) {
      var t = lines > 1 ? i / (lines - 1) : 0.5;
      /* Slight vertical overscan so lines run off both edges */
      var baseY = h * (-0.06 + 1.12 * t);

      /* Brighten the strata passing near the cursor */
      var boost = 1;
      if (hasPointer) {
        var dy = (pY * h - baseY) / (h * 0.22);
        boost = 1 + 0.55 * Math.exp(-dy * dy);
      }

      /* Slow, per-line opacity breathing */
      var s = Math.sin(time * 0.14 + t * 5.5);
      var fade = 0.45 + 0.55 * (s * s);
      var alpha = (0.055 + 0.075 * (1 - Math.abs(t - 0.5) * 2)) * fade * boost;
      if (alpha < 0.005) return;

      /* Colour drifts teal -> aqua -> cyan down the page */
      var col = t < 0.34 ? TEAL : (t < 0.7 ? AQUA : CYAN);

      /* Amplitude swells and settles with the breathing envelope */
      var amp = 1 + 0.18 * breathe;

      ctx.beginPath();
      var first = true;
      for (var x = -step; x <= w + step; x += step) {
        /* Three octaves; the small `t` coefficients keep adjacent lines
           correlated so the field flows as layered bands. */
        var y = baseY
          + Math.sin(x * 0.0016 + time * 0.16 + t * 2.2) * 34 * amp
          + Math.sin(x * 0.0034 - time * 0.11 + t * 3.1) * 17 * amp
          + Math.sin(x * 0.0072 + time * 0.08 + t * 1.4) * 7 * amp;

        if (first) { ctx.moveTo(x, y); first = false; }
        else { ctx.lineTo(x, y); }
      }

      ctx.strokeStyle = rgba(col, alpha);
      ctx.lineWidth = mobile ? 0.6 : 0.7;
      ctx.stroke();
    }

    function drawParticles(time) {
      for (var i = 0; i < particles.length; i++) {
        var p = particles[i];
        p.x += p.vx;
        p.y += p.vy;
        if (p.y < -10) { p.y = h + 10; p.x = Math.random() * w; }
        if (p.x < -10) p.x = w + 10;
        if (p.x > w + 10) p.x = -10;

        var tw = 0.55 + 0.45 * Math.sin(time * 0.5 + p.ph);
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fillStyle = rgba(AQUA, p.a * tw);
        ctx.fill();
      }
    }

    /* Soft glow that follows the cursor at a distance — reads as the field
       responding to presence, not as a cursor follower. */
    function drawGlow() {
      if (!hasPointer) return;
      var gx = pX * w, gy = pY * h;
      var r = Math.min(w, h) * 0.30;
      var g = ctx.createRadialGradient(gx, gy, 0, gx, gy, r);
      g.addColorStop(0, rgba(CYAN, 0.10));
      g.addColorStop(0.55, rgba(AQUA, 0.04));
      g.addColorStop(1, rgba(AQUA, 0));
      ctx.fillStyle = g;
      ctx.fillRect(gx - r, gy - r, r * 2, r * 2);
    }

    function frame(time) {
      ctx.clearRect(0, 0, w, h);

      /* Breathing envelope: one full cycle every BREATH seconds */
      var breathe = Math.sin((time / BREATH) * Math.PI * 2);

      /* Ease the pointer, then translate the whole field a few px */
      pX += (pTargetX - pX) * 0.045;
      pY += (pTargetY - pY) * 0.045;

      ctx.save();
      if (hasPointer) {
        ctx.translate((pX - 0.5) * 2 * MAX_PARALLAX, (pY - 0.5) * 2 * MAX_PARALLAX);
      }
      drawGlow();
      for (var i = 0; i < lines; i++) drawFlow(i, time, breathe);
      drawParticles(time);
      ctx.restore();
    }

    /* ---- Boot ---- */
    resize();

    /* Paint one frame synchronously so the field is already composed on first
       paint (no blank flash), and so it still renders in embedded webviews that
       throttle or suspend requestAnimationFrame — same defensive reasoning as
       the reveal-on-scroll logic in galim.js. */
    frame(0);

    if (!reduced) {
      var start = null;
      var raf = null;

      function loop(ts) {
        if (start === null) start = ts;
        frame((ts - start) / 1000);
        raf = window.requestAnimationFrame(loop);
      }
      raf = window.requestAnimationFrame(loop);

      /* Don't burn cycles in a background tab */
      document.addEventListener('visibilitychange', function () {
        if (document.hidden) {
          if (raf) { window.cancelAnimationFrame(raf); raf = null; }
        } else if (!raf) {
          start = null;
          raf = window.requestAnimationFrame(loop);
        }
      });

      /* Cursor interaction: pointer devices only */
      if (!coarse) {
        window.addEventListener('pointermove', function (e) {
          if (e.pointerType === 'touch') return;
          hasPointer = true;
          pTargetX = e.clientX / Math.max(1, window.innerWidth);
          pTargetY = e.clientY / Math.max(1, window.innerHeight);
        }, { passive: true });

        document.addEventListener('pointerleave', function () {
          hasPointer = false;
          pTargetX = 0.5;
          pTargetY = 0.5;
        });
      }
    }

    /* Debounced resize */
    var rt = null;
    window.addEventListener('resize', function () {
      window.clearTimeout(rt);
      rt = window.setTimeout(function () {
        resize();
        if (reduced) frame(0);
      }, 150);
    }, { passive: true });
  })();
</script>
